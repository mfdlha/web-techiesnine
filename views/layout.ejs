                    </span>
                    <span class="truncate"><%= matkul.nama_matkul %></span>
                  </a>
                <% }); %>
              <% } else { %>
                <p class="px-3 py-1 text-xs text-stone-400 italic">Belum ada mata kuliah</p>
              <% } %>
            </div>
          </details>

          <!-- Section "Tautan Cepat" -->
          <div>
            <div class="flex items-center justify-between px-2 mb-2">
              <p class="text-[11px] font-semibold tracking-wider text-stone-400 dark:text-stone-500 uppercase">
                Tautan Cepat
              </p>
              <span class="text-[11px] text-stone-400 dark:text-stone-500 font-mono">
