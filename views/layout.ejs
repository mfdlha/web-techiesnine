              Menu Utama
            </p>
            <nav class="space-y-1">
              
              <!-- Dashboard -->
              <a href="/" class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-medium transition <%= (typeof currentPage !== 'undefined' && currentPage === 'beranda') ? 'bg-stone-100 dark:bg-stone-800/80 text-stone-900 dark:text-white font-semibold' : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-white hover:bg-stone-50 dark:hover:bg-stone-800/40' %>">
