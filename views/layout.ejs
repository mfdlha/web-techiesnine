          </div>

          <!-- Section "MATA KULIAH" Dropdown -->
          <details class="group/matkul dropdown" open>
            <summary class="flex items-center justify-between px-2 mb-2 cursor-pointer list-none select-none">
              <span class="text-[11px] font-semibold tracking-wider text-stone-400 dark:text-stone-500 uppercase">
                MATA KULIAH
              </span>
              <svg class="w-3.5 h-3.5 text-stone-400 transition-transform duration-200 group-open/matkul:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
