<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  <div class="max-w-4xl mx-auto">
    
    <div class="mb-8">
      <a href="/kas" class="inline-flex items-center text-stone-500 dark:text-gray-400 hover:text-stone-900 dark:hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7 7-7"></path></svg>
        <span>Kembali ke Laporan Keuangan</span>
      </a>
      <h1 class="text-2xl font-bold text-stone-900 dark:text-white mb-2">Rincian Pemasukan Kas</h1>
      <p class="text-stone-500 dark:text-gray-400 text-sm">Detail transparansi penerimaan iuran mingguan dan sumber dana kas lainnya.</p>
    </div>

    <div class="overflow-x-auto border border-stone-200/80 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A] shadow-xs">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-stone-200/80 dark:border-stone-800 bg-stone-50/75 dark:bg-stone-900/40 text-stone-500 dark:text-stone-400 text-xs uppercase font-medium tracking-wider">
            <th scope="col" class="py-3.5 pl-6 pr-4">Tanggal</th>
            <th scope="col" class="py-3.5 px-4">Keterangan Pemasukan</th>
            <th scope="col" class="py-3.5 px-4">Jenis Mutasi</th>
            <th scope="col" class="py-3.5 pl-4 pr-6 text-right whitespace-nowrap">Total Bayar (Rp)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100 dark:divide-stone-800/60 text-sm">
          <% if (typeof pemasukan !== 'undefined' && pemasukan.length > 0) { %>
            <% pemasukan.forEach(p => { %>
              <tr class="hover:bg-stone-50/80 dark:hover:bg-stone-800/40 transition">
                <td class="py-3.5 pl-6 pr-4 tabular-nums text-xs font-medium text-stone-500 dark:text-stone-400 whitespace-nowrap">
                  <%= p.tanggal %>
                </td>
                <td class="py-3.5 px-4 font-medium text-stone-900 dark:text-white leading-relaxed">
                  <%= p.keterangan %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                    <span>Pemasukan</span>
                  </span>
                </td>
                <td class="py-3.5 pl-4 pr-6 text-right tabular-nums font-semibold whitespace-nowrap text-emerald-600 dark:text-emerald-400">
                  +Rp <%= Number(p.nominal).toLocaleString('id-ID') %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4" class="py-8 text-center text-xs text-stone-400 italic">
                Belum ada catatan pemasukan kas.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>
