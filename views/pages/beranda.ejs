<!-- =======================================================================
     ZONA ATAS: Warm Cream / Alabaster (bg-[#F5F4EE] dark:bg-[#1A1918] border-b border-stone-200 dark:border-stone-800)
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  
  <!-- 1. Action Bar Atas (Portal Informasi) -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-stone-200/70 dark:border-stone-800">
    
    <!-- Kiri: Judul Halaman Dashboard -->
    <div>
      <h1 class="font-heading font-extrabold text-2xl tracking-tight text-stone-900 dark:text-white">
        Dashboard Utama Kelas
      </h1>
    </div>

    <!-- Kanan: Status Informasi Semester & Metrik Real-Time -->
    <div class="flex items-center gap-3 self-end sm:self-auto flex-wrap">
      <!-- Pill Ringkasan Statistik Real-Time Header -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-800 rounded-full bg-white dark:bg-[#1C1B1A] shadow-xs tabular-nums">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span><strong class="text-stone-900 dark:text-white"><%= typeof totalTugasAktif !== 'undefined' ? totalTugasAktif : (typeof statsTugas !== 'undefined' ? statsTugas.total : 0) %></strong> Tugas</span>
        <span class="text-stone-300 dark:text-stone-700">•</span>
        <span><strong class="text-stone-900 dark:text-white"><%= typeof totalMentariAktif !== 'undefined' ? totalMentariAktif : 0 %></strong> Mentari</span>
      </div>
    </div>
  </div>

  <!-- 2. Bento Analytics Row (Grid 3 Kolom) -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-5">
    
    <!-- KOLOM 1: Aktivitas Perkuliahan -->
    <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/80 dark:border-stone-800 rounded-2xl p-5 shadow-[0_1px_2px_rgba(0,0,0,0.03)] flex flex-col justify-between transition">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          Aktivitas Mingguan
        </span>
        <span class="text-[11px] font-medium text-stone-400 dark:text-stone-500 tabular-nums">
          Semester 5
        </span>
      </div>

      <!-- Bar Chart Visual Rhythm -->
      <div class="h-28 flex items-end justify-between gap-2.5 px-2 pt-2">
        <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
          <div class="w-full bg-stone-300 dark:bg-stone-700 rounded-t-md h-[55%] transition-all group-hover:opacity-80"></div>
          <span class="text-[11px] font-medium text-stone-500 dark:text-stone-400 tabular-nums">Sen</span>
        </div>
        <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
          <div class="w-full bg-stone-900 dark:bg-stone-100 rounded-t-md h-[88%] transition-all relative"></div>
          <span class="text-[11px] font-semibold text-stone-900 dark:text-stone-100 tabular-nums">Sel</span>
        </div>
        <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
          <div class="w-full bg-stone-300 dark:bg-stone-700 rounded-t-md h-[40%] transition-all group-hover:bg-stone-400 dark:group-hover:bg-stone-600"></div>
          <span class="text-[11px] font-medium text-stone-500 dark:text-stone-400 tabular-nums">Rab</span>
        </div>
        <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
          <div class="w-full bg-stone-900 dark:bg-stone-100 rounded-t-md h-[95%] transition-all relative"></div>
          <span class="text-[11px] font-semibold text-stone-900 dark:text-stone-100 tabular-nums">Kam</span>
        </div>
        <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
          <div class="w-full bg-stone-300 dark:bg-stone-700 rounded-t-md h-[65%] transition-all group-hover:opacity-80"></div>
          <span class="text-[11px] font-medium text-stone-500 dark:text-stone-400 tabular-nums">Jum</span>
        </div>
      </div>

      <div class="mt-3 pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-[11px] text-stone-400 dark:text-stone-500">
        <span>Kurikulum Terdaftar</span>
        <span class="font-medium text-stone-700 dark:text-stone-300 tabular-nums"><%= typeof totalMatkul !== 'undefined' ? totalMatkul : (typeof mataKuliah !== 'undefined' ? mataKuliah.length : 0) %> Mata Kuliah</span>
      </div>
    </div>

    <!-- KOLOM 2: Metrik Tugas (Tugas Aktif Dinamis) -->
    <a href="/tugas" class="bg-white dark:bg-[#1C1B1A] border border-stone-200/80 dark:border-stone-800 rounded-2xl p-5 shadow-[0_1px_2px_rgba(0,0,0,0.03)] flex flex-col justify-between group hover:border-stone-400 dark:hover:border-stone-600 transition block">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          Tugas Aktif
        </span>
        <div class="w-6 h-6 rounded-full bg-stone-100 dark:bg-stone-800 flex items-center justify-center text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition">
          <svg class="w-3.5 h-3.5 transition transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </div>
      </div>

      <div class="my-3">
        <span class="font-heading font-extrabold text-4xl tabular-nums text-stone-900 dark:text-white tracking-tight">
          <%= typeof totalTugasAktif !== 'undefined' ? totalTugasAktif : (typeof statsTugas !== 'undefined' ? statsTugas.total : 0) %>
        </span>
        <p class="text-xs text-stone-500 dark:text-stone-400 font-medium mt-1">
          Tugas kuliah yang sedang berjalan
        </p>
      </div>

      <div class="pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-xs text-stone-500 dark:text-stone-400">
        <span>Tenggat terdekat</span>
        <span class="bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400 text-xs font-medium px-2.5 py-1 rounded-md tabular-nums">
          <%= typeof statsTugas !== 'undefined' ? statsTugas.pekanIni : 0 %> Tugas Mendatang
        </span>
      </div>
    </a>

    <!-- KOLOM 3: Metrik Kas Kelas (Saldo Kas Dinamis) -->
    <a href="/kas" class="bg-white dark:bg-[#1C1B1A] border border-stone-200/80 dark:border-stone-800 rounded-2xl p-5 shadow-[0_1px_2px_rgba(0,0,0,0.03)] flex flex-col justify-between group hover:border-stone-400 dark:hover:border-stone-600 transition block">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          Saldo Kas Kelas
        </span>
        <div class="w-6 h-6 rounded-full bg-stone-100 dark:bg-stone-800 flex items-center justify-center text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
          </svg>
        </div>
      </div>

      <div class="my-3">
        <div class="text-3xl lg:text-4xl font-bold tabular-nums tracking-tight text-stone-900 dark:text-white mt-2">
          Rp <%= Number((typeof statsKas !== 'undefined' ? statsKas.saldo : 0)).toLocaleString('id-ID') %>
        </div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-1">
          Kas Terverifikasi Real-Time
        </div>
      </div>

      <div class="pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-[11px] text-stone-400 dark:text-stone-500">
        <span>Total Kas Masuk</span>
        <span class="font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-1.5 py-0.5 rounded tabular-nums">
          +Rp <%= Number((typeof statsKas !== 'undefined' ? statsKas.pemasukan : 0)).toLocaleString('id-ID') %>
        </span>
      </div>
    </a>

  </div>

</div>


<!-- =======================================================================
     ZONA BAWAH: KANBAN BOARD TUGAS & SEKSI MENTARI (bg-white dark:bg-[#121211] p-6 lg:p-8)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors space-y-12">
  
  <!-- ================= SECTION 1: PAPAN TUGAS AKTIF (LEBAR PENUH) ================= -->
  <section>
    
    <!-- Section Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <div class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-1">
          <span>Tugas Aktif & Mendatang</span>
        </div>
        <h2 class="font-heading font-extrabold text-xl sm:text-2xl text-stone-900 dark:text-white tracking-tight">
          Papan Pantau Informasi Tugas
        </h2>
        <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">
          Monitoring instruksi pengumpulan tugas perkuliahan kelas 05TPLP009
        </p>
      </div>

      <!-- Link ke Halaman Daftar Lengkap -->
      <a href="/tugas" class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-700 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white border border-stone-200 dark:border-stone-800 px-3.5 py-2 rounded-xl bg-stone-50 dark:bg-[#1C1B1A] hover:bg-stone-100 dark:hover:bg-stone-800 transition shadow-xs">
        <span>Lihat Semua Detail</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>

    <!-- Container Tugas Aktif: Full Width (Grid Responsif 1, 2, atau 3 Kolom) -->
    <% const listAktif = typeof tugasAktif !== 'undefined' ? tugasAktif : (typeof tugas !== 'undefined' ? tugas : []); %>
    <% if (listAktif.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <% listAktif.slice(0, 3).forEach((t) => { %>
          <% 
            const now = new Date();
            const deadline = new Date(t.batas_waktu);
            const diffTime = deadline - now;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            let pillText = "";
            let pillColor = "";
            
            if (t.status === 'Selesai') {
              pillText = "Selesai";
              pillColor = "bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-300";
            } else if (diffDays < 0) {
              pillText = "Lewat Tenggat";
              pillColor = "bg-rose-500/10 text-rose-400";
            } else if (diffDays === 0) {
              pillText = "Hari Ini";
              pillColor = "bg-red-500/10 text-red-400 font-semibold";
            } else if (diffDays <= 2) {
              pillText = diffDays + " Hari Lagi";
              pillColor = "bg-red-500/10 text-red-400 font-semibold";
            } else if (diffDays <= 5) {
              pillText = diffDays + " Hari Lagi";
              pillColor = "bg-amber-500/10 text-amber-400";
            } else {
              pillText = diffDays + " Hari Lagi";
              pillColor = "bg-emerald-500/10 text-emerald-400";
            }
          %>
          <div 
            onclick="window.location.href='/tugas/<%= t.id %>'" 
            class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-5 flex flex-col justify-between shadow-xs transition hover:border-stone-400 dark:hover:border-stone-700 cursor-pointer group"
          >
            <div>
              <div class="flex items-start justify-between gap-2 mb-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 text-xs font-bold px-2 py-0.5 rounded-md truncate max-w-[140px] sm:max-w-full inline-block">
                    <%= t.matkul %>
                  </span>
                  <span class="text-stone-600 dark:text-stone-400 text-xs font-medium px-2 py-0.5 rounded-md bg-stone-100 dark:bg-stone-800/60">
                    <%= t.tipe %>
                  </span>
                </div>
                <!-- Badge Status Deadline -->
                <span class="inline-flex items-center text-xs px-2.5 py-0.5 rounded-full <%= pillColor %> font-medium tabular-nums shadow-xs whitespace-nowrap">
                  <%= pillText %>
                </span>
              </div>

              <h3 class="font-heading font-bold text-base sm:text-lg text-stone-900 dark:text-white transition-colors line-clamp-2 mt-3 leading-snug">
                <a href="/tugas/<%= t.id %>" onclick="event.stopPropagation();">
                  <%= t.judul %>
                </a>
              </h3>
            </div>

            <!-- Footer: Batas Waktu & Tombol Lihat Detail -->
            <div class="flex items-center justify-between gap-2 mt-5 pt-4 border-t border-stone-100 dark:border-stone-800">
              <div class="flex items-center gap-1.5 text-xs text-stone-500 dark:text-stone-400 tabular-nums">
                <svg class="w-4 h-4 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span><%= t.batas_waktu ? t.batas_waktu.replace('T', ' ') : '-' %></span>
              </div>

              <a 
                href="/tugas/<%= t.id %>" 
                onclick="event.stopPropagation();"
                class="inline-flex items-center justify-center gap-1 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-stone-100 dark:bg-[#252525] border border-stone-300 dark:border-gray-700 rounded-lg hover:bg-stone-200 dark:hover:bg-gray-700 hover:text-black dark:hover:text-white transition-colors"
              >
                Lihat Detail
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="p-10 text-center border border-dashed border-stone-200 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A]">
        <svg class="w-10 h-10 mx-auto text-emerald-500/80 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-stone-800 dark:text-stone-200 font-semibold text-sm">Semua tugas selesai!</p>
        <p class="text-xs text-stone-400 mt-1">Tidak ada tugas aktif yang tertunda saat ini.</p>
      </div>
    <% } %>

  </section>

  <!-- ================= SECTION: ARSIP & RIWAYAT TUGAS (<details> DROPDOWN - LIST BARIS MINI) ================= -->
  <details class="group mt-12 pt-8 border-t border-stone-200/80 dark:border-stone-800">
    <summary class="flex items-center justify-between cursor-pointer list-none py-2 select-none group-open:mb-4 transition">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-500 dark:text-stone-400 flex items-center justify-center transition group-open:rotate-90">
          <svg class="w-4 h-4 transition duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
          </svg>
        </div>
        <div>
          <h2 class="font-heading font-extrabold text-lg sm:text-xl text-stone-900 dark:text-white tracking-tight">
            Arsip & Riwayat Tugas Selesai
          </h2>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 text-xs px-2.5 py-1 rounded-md font-semibold whitespace-nowrap">
          <%= (typeof tugasArsip !== 'undefined' ? tugasArsip.length : (typeof tugasSelesai !== 'undefined' ? tugasSelesai.length : 0)) %> Diarsipkan
        </span>
      </div>
    </summary>

    <!-- List Baris Mini (Flexbox Horizontal baris vertikal kecil) -->
    <div class="border border-stone-200 dark:border-stone-800 rounded-2xl overflow-hidden bg-white dark:bg-[#1C1B1A] divide-y divide-stone-100 dark:divide-stone-800 shadow-xs">
      <% const listArsip = typeof tugasArsip !== 'undefined' ? tugasArsip : (typeof tugasSelesai !== 'undefined' ? tugasSelesai : []); %>
      <% if (listArsip.length > 0) { %>
        <% listArsip.forEach(t => { %>
          <div class="flex items-center justify-between gap-4 px-4 py-2.5 hover:bg-stone-50 dark:hover:bg-stone-800/40 transition">
            
            <!-- Judul Matkul & Nama Tugas -->
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex-shrink-0">
                <%= t.matkul %>
              </span>
              <span class="text-xs font-medium text-stone-400 dark:text-stone-500 font-mono hidden md:inline">
                <%= t.tipe %>
              </span>
              <span class="text-sm font-medium text-stone-900 dark:text-stone-100 truncate">
                <%= t.judul %>
              </span>
            </div>

            <!-- Tanggal, Badge Selesai, dan Link Drive -->
            <div class="flex items-center gap-2.5 flex-shrink-0">
              <span class="text-xs text-stone-400 dark:text-stone-500 tabular-nums hidden sm:inline">
                <%= t.batas_waktu ? t.batas_waktu.slice(0, 10) : '' %>
              </span>
              
              <span class="inline-flex items-center text-[11px] px-2 py-0.5 rounded-full font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 whitespace-nowrap">
                Selesai
              </span>

              <% if (t.link_drive && t.link_drive.trim() !== '') { %>
                <a 
                  href="<%= t.link_drive %>" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="p-1 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition" 
                  title="Buka Drive"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                  </svg>
                </a>
              <% } %>
            </div>

          </div>
        <% }); %>
      <% } else { %>
        <div class="p-8 text-center text-xs text-stone-400 italic">
          Belum ada riwayat tugas yang selesai atau lampau.
        </div>
      <% } %>
    </div>
  </details>


  <!-- ================= SECTION 2: ZONA BARU KHUSUS MENTARI E-LEARNING ================= -->
  <section class="pt-8 border-t border-stone-200/80 dark:border-stone-800">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
      <div>
        <h3 class="font-semibold text-lg text-stone-900 dark:text-white mb-0.5">
          Jadwal Mentari E-Learning
        </h3>
        <p class="text-xs text-stone-500 dark:text-stone-400">
          Sesi perkuliahan daring aktif di portal mentari.unpam.ac.id
        </p>
      </div>

      <a 
        href="/mentari" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-700 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white border border-stone-200 dark:border-stone-800 px-3 py-1.5 rounded-lg bg-stone-50 dark:bg-[#1C1B1A] transition self-start sm:self-auto"
      >
        <span>Lihat Semua Sesi Mentari</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>

    <% const listMentariAktif = typeof mentariAktif !== 'undefined' ? mentariAktif : (typeof mentariTerdekat !== 'undefined' ? mentariTerdekat : []); %>
    <% if (listMentariAktif && listMentariAktif.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% listMentariAktif.slice(0, 3).forEach(m => { %>
          <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-5 flex flex-col justify-between shadow-xs transition hover:border-stone-400 dark:hover:border-stone-700">
            <div>
              <!-- Header Kartu: badge pertemuan & badge status warna -->
              <div class="flex items-center justify-between gap-2">
                <span class="bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 text-xs px-2.5 py-1 rounded-md font-semibold">
                  <%= m.pertemuan %>
                </span>
                <span class="bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400 text-xs px-2.5 py-1 rounded-full font-medium inline-flex items-center">
                  <span><%= m.status %></span>
                </span>
              </div>

              <!-- Nama Mata Kuliah -->
              <h4 class="font-heading font-bold text-base text-stone-900 dark:text-white mt-3 leading-snug">
                <%= m.matkul %>
              </h4>
            </div>

            <div>
              <div class="border-t border-stone-100 dark:border-stone-800 my-4"></div>

              <!-- Tenggat Waktu (dengan ikon jam) -->
              <div class="flex items-center gap-1.5 text-xs text-stone-600 dark:text-stone-400 font-medium tabular-nums">
                <svg class="w-3.5 h-3.5 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Batas Waktu: <%= m.batas_waktu ? m.batas_waktu.replace('T', ' ') : '-' %></span>
              </div>

              <!-- Tombol CTA sekunder (outline button) "Cek Mentari UNPAM ↗" -->
              <a 
                href="<%= (m.link_mentari && m.link_mentari.trim() !== '') ? m.link_mentari : 'https://elearning.unpam.ac.id/' %>" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="mt-3 w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-800 transition"
              >
                <span>Cek Mentari UNPAM ↗</span>
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="p-8 text-center border border-dashed border-stone-200 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A]">
        <p class="text-xs text-stone-400 dark:text-stone-500 italic">
          Tidak ada jadwal E-Learning aktif saat ini
        </p>
      </div>
    <% } %>

  </section>

</div>
