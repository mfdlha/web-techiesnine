<!-- =======================================================================
     ZONA ATAS: Summary Cards (bg-[#F5F4EE] dark:bg-[#1A1918] border-b border-stone-200 dark:border-stone-800)
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  
  <!-- Header Halaman Tegas -->
  <div class="max-w-4xl">
    <h1 class="font-heading font-extrabold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-stone-900 dark:text-white">
      Laporan Keuangan
    </h1>
    
    <p class="text-sm text-stone-600 dark:text-stone-400 mt-2 leading-relaxed">
      Catatan transparansi pemasukan iuran mingguan dan pengeluaran dana kas kelas.
    </p>
  </div>

  <!-- Grid 3 Kolom Kartu Ringkasan Keuangan -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-5">
    
    <!-- Kartu 1: Saldo Kas Saat Ini -->
    <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between transition">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          Saldo Saat Ini
        </span>
        <div class="w-7 h-7 rounded-full bg-stone-100 dark:bg-stone-800 flex items-center justify-center text-stone-500 dark:text-stone-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
          </svg>
        </div>
      </div>

      <div class="my-3">
        <div class="text-3xl lg:text-4xl font-bold tabular-nums tracking-tight text-stone-900 dark:text-white mt-2">
          Rp <%= Number((typeof statsKas !== 'undefined' ? statsKas.saldo : 0)).toLocaleString('id-ID') %>
        </div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-1">
          Kas Terverifikasi Real-Time
        </div>
      </div>

      <div class="pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-[11px] text-stone-400 dark:text-stone-500">
        <span>Status rekonsiliasi</span>
        <span class="font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-1.5 py-0.5 rounded tabular-nums">
          Sesuai Pembukuan
        </span>
      </div>
    </div>

    <!-- Kartu 2: Pemasukan Bulan Ini -->
    <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between transition">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          Total Pemasukan
        </span>
        <div class="w-7 h-7 rounded-full bg-emerald-50 dark:bg-emerald-950/50 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75"/>
          </svg>
        </div>
      </div>

      <div class="my-3">
        <div class="text-3xl lg:text-4xl font-bold tabular-nums tracking-tight text-emerald-600 dark:text-emerald-400 mt-2">
          +Rp <%= Number((typeof statsKas !== 'undefined' ? statsKas.pemasukan : 0)).toLocaleString('id-ID') %>
        </div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-1">
          Akumulasi dana kas masuk
        </div>
      </div>

      <div class="pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-[11px] text-stone-400 dark:text-stone-500">
        <span>Total transaksi</span>
        <span class="font-medium text-stone-700 dark:text-stone-300 tabular-nums">
          <%= typeof kas !== 'undefined' ? kas.length : 0 %> transaksi
        </span>
      </div>
    </div>

    <!-- Kartu 3: Pengeluaran Bulan Ini (Clickable Link ke /kas/pengeluaran) -->
    <a 
      href="/kas/pengeluaran" 
      class="block bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 hover:border-gray-600 dark:hover:border-gray-600 transition-colors p-5 rounded-2xl shadow-xs flex flex-col justify-between cursor-pointer group"
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          Total Pengeluaran
        </span>
        <div class="w-7 h-7 rounded-full bg-rose-50 dark:bg-rose-950/50 flex items-center justify-center text-rose-600 dark:text-rose-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19.5v-15m0 0l-6.75 6.75M12 4.5l6.75 6.75"/>
          </svg>
        </div>
      </div>

      <div class="my-3">
        <div class="text-3xl lg:text-4xl font-bold tabular-nums tracking-tight text-rose-600 dark:text-rose-400 mt-2">
          -Rp <%= Number((typeof statsKas !== 'undefined' ? statsKas.pengeluaran : 0)).toLocaleString('id-ID') %>
        </div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-1">
          Operasional & kebutuhan kelas
        </div>
      </div>

      <div class="pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-[11px] text-stone-400 dark:text-stone-500">
        <span>Penggunaan dana</span>
        <span class="font-medium text-stone-700 dark:text-stone-300 tabular-nums">
          Belanja & perlengkapan
        </span>
      </div>
    </a>

  </div>

</div>


<!-- =======================================================================
     ZONA BAWAH: Tabel Riwayat Transaksi (bg-white dark:bg-[#121211] p-6 lg:p-8)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  
  <div class="max-w-5xl">
    
    <!-- Table Section Header -->
    <div class="mb-6">
      <h2 class="font-heading font-bold text-xl text-stone-900 dark:text-white tracking-tight">
        Riwayat Arus Kas
      </h2>
      <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">
        Catatan kronologis penerimaan iuran dan belanja kelas semester 5
      </p>
    </div>

    <!-- ================= 1. DESKTOP DATA TABLE (md ke atas) ================= -->
    <% 
      const allKas = (typeof kas !== 'undefined' && kas) ? kas : [];
      const kasBaru = allKas.slice(0, 5);
      const kasLama = allKas.slice(5);
    %>

    <div class="hidden md:block overflow-x-auto border border-stone-200/80 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A] shadow-xs">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-stone-200/80 dark:border-stone-800 bg-stone-50/75 dark:bg-stone-900/40 text-stone-500 dark:text-stone-400 text-xs uppercase font-medium tracking-wider">
            <th scope="col" class="py-3.5 pl-6 pr-4">Tanggal</th>
            <th scope="col" class="py-3.5 px-4">Keterangan</th>
            <th scope="col" class="py-3.5 px-4">Jenis Mutasi</th>
            <th scope="col" class="py-3.5 pl-4 pr-6 text-right">Nominal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100 dark:divide-stone-800/60 text-sm">
          <% if (kasBaru.length > 0) { %>
            <% kasBaru.forEach(k => { %>
              <% const isMasuk = (k.jenis && k.jenis.trim().toLowerCase() === 'pemasukan') || (k.keterangan && k.keterangan.toLowerCase().includes('iuran')); %>
              <tr class="hover:bg-stone-50/80 dark:hover:bg-stone-800/40 transition">
                <td class="py-3.5 pl-6 pr-4 tabular-nums text-xs font-medium text-stone-500 dark:text-stone-400 whitespace-nowrap">
                  <%= k.tanggal %>
                </td>
                <td class="py-3.5 px-4">
                  <p class="font-medium text-stone-900 dark:text-white"><%= k.keterangan.replace(/Iuran Kas - /i, '') %></p>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <% if (isMasuk) { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                      <span>Pemasukan</span>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                      <span>Pengeluaran</span>
                    </span>
                  <% } %>
                </td>
                <td class="py-3.5 pl-4 pr-6 text-right tabular-nums font-semibold whitespace-nowrap <%= isMasuk ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                  <%= isMasuk ? '+' : '-' %>Rp <%= Number(k.nominal || 0).toLocaleString('id-ID') %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4" class="py-8 text-center text-xs text-stone-400 italic">
                Belum ada transaksi kas yang dicatat di basis data.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- ================= 2. MOBILE CARD VIEW (< md) ================= -->
    <div class="md:hidden space-y-3">
      <% if (kasBaru.length > 0) { %>
        <% kasBaru.forEach(k => { %>
          <% const isMasuk = (k.jenis && k.jenis.trim().toLowerCase() === 'pemasukan') || (k.keterangan && k.keterangan.toLowerCase().includes('iuran')); %>
          <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-xl p-4 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="tabular-nums font-medium text-stone-500 dark:text-stone-400"><%= k.tanggal %></span>
              <% if (isMasuk) { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[11px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400">
                  Pemasukan
                </span>
              <% } else { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[11px] font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-400">
                  Pengeluaran
                </span>
              <% } %>
            </div>
            <div>
              <p class="text-sm font-semibold text-stone-900 dark:text-white leading-snug">
                <%= k.keterangan.replace(/Iuran Kas - /i, '') %>
              </p>
            </div>
            <div class="pt-2 border-t border-stone-100 dark:border-stone-800/60 flex items-center justify-between">
              <span class="text-xs text-stone-400 dark:text-stone-500">Nominal:</span>
              <span class="text-sm font-bold tabular-nums <%= isMasuk ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                <%= isMasuk ? '+' : '-' %>Rp <%= Number(k.nominal || 0).toLocaleString('id-ID') %>
              </span>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="p-8 text-center border border-dashed border-stone-200 dark:border-stone-800 rounded-xl text-xs text-stone-400">
          Belum ada riwayat transaksi kas.
        </div>
      <% } %>
    </div>

    <!-- ================= 3. RIWAYAT TERDAHULU (DROPDOWN DETAILS) ================= -->
    <% if (kasLama.length > 0) { %>
      <details class="group mt-6">
        <summary class="flex items-center justify-between cursor-pointer list-none py-3.5 px-5 rounded-2xl bg-stone-50 dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 text-xs sm:text-sm font-semibold text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition select-none group-open:mb-4 shadow-xs">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-stone-500 transition-transform duration-200 group-open:rotate-90 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
            <span>Tampilkan Riwayat Terdahulu</span>
          </div>
          <span class="text-xs font-mono font-medium text-stone-500 bg-stone-200/70 dark:bg-stone-800 px-2.5 py-0.5 rounded-full"><%= kasLama.length %> Transaksi Lampau</span>
        </summary>

        <!-- Desktop Data Table untuk Riwayat Lampau -->
        <div class="hidden md:block overflow-x-auto border border-stone-200/80 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A] shadow-xs">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-stone-200/80 dark:border-stone-800 bg-stone-50/75 dark:bg-stone-900/40 text-stone-500 dark:text-stone-400 text-xs uppercase font-medium tracking-wider">
                <th scope="col" class="py-3.5 pl-6 pr-4">Tanggal</th>
                <th scope="col" class="py-3.5 px-4">Keterangan</th>
                <th scope="col" class="py-3.5 px-4">Jenis Mutasi</th>
                <th scope="col" class="py-3.5 pl-4 pr-6 text-right">Nominal</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100 dark:divide-stone-800/60 text-sm">
              <% kasLama.forEach(k => { %>
                <% const isMasuk = (k.jenis && k.jenis.trim().toLowerCase() === 'pemasukan') || (k.keterangan && k.keterangan.toLowerCase().includes('iuran')); %>
                <tr class="hover:bg-stone-50/80 dark:hover:bg-stone-800/40 transition">
                  <td class="py-3.5 pl-6 pr-4 tabular-nums text-xs font-medium text-stone-500 dark:text-stone-400 whitespace-nowrap">
                    <%= k.tanggal %>
                  </td>
                  <td class="py-3.5 px-4">
                    <p class="font-medium text-stone-900 dark:text-white"><%= k.keterangan.replace(/Iuran Kas - /i, '') %></p>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <% if (isMasuk) { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                        <span>Pemasukan</span>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                        <span>Pengeluaran</span>
                      </span>
                    <% } %>
                  </td>
                  <td class="py-3.5 pl-4 pr-6 text-right tabular-nums font-semibold whitespace-nowrap <%= isMasuk ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                    <%= isMasuk ? '+' : '-' %>Rp <%= Number(k.nominal || 0).toLocaleString('id-ID') %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Mobile Card View untuk Riwayat Lampau -->
        <div class="md:hidden space-y-3 mt-3">
          <% kasLama.forEach(k => { %>
            <% const isMasuk = (k.jenis && k.jenis.trim().toLowerCase() === 'pemasukan') || (k.keterangan && k.keterangan.toLowerCase().includes('iuran')); %>
            <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-xl p-4 shadow-xs space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="tabular-nums font-medium text-stone-500 dark:text-stone-400"><%= k.tanggal %></span>
                <% if (isMasuk) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[11px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400">
                    Pemasukan
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[11px] font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-400">
                    Pengeluaran
                  </span>
                <% } %>
              </div>
              <div>
                <p class="text-sm font-semibold text-stone-900 dark:text-white leading-snug">
                  <%= k.keterangan.replace(/Iuran Kas - /i, '') %>
                </p>
              </div>
              <div class="pt-2 border-t border-stone-100 dark:border-stone-800/60 flex items-center justify-between">
                <span class="text-xs text-stone-400 dark:text-stone-500">Nominal:</span>
                <span class="text-sm font-bold tabular-nums <%= isMasuk ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                  <%= isMasuk ? '+' : '-' %>Rp <%= Number(k.nominal || 0).toLocaleString('id-ID') %>
                </span>
              </div>
            </div>
          <% }); %>
        </div>
      </details>
    <% } %>

  </div>

</div>
