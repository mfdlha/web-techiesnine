<!-- Header & Back Navigation -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  <div class="max-w-2xl mx-auto flex items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 text-stone-700 dark:text-stone-300 mb-2 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span>Formulir Terpisah • Mentari E-Learning</span>
      </div>
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl tracking-tight text-stone-900 dark:text-white">
        Tambah Sesi Mentari E-Learning
      </h1>
      <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-1">
        Jadwalkan batas waktu absensi, forum diskusi, dan kuis perkuliahan daring UNPAM.
      </p>
    </div>

    <!-- Tombol Kembali ke Daftar -->
    <a 
      href="/admin/mentari-list" 
      class="inline-flex items-center gap-2 text-xs font-semibold text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white border border-stone-200 dark:border-stone-700 px-3.5 py-2 rounded-xl bg-white dark:bg-[#1C1B1A] hover:bg-stone-50 dark:hover:bg-stone-800 transition shadow-xs flex-shrink-0"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      <span class="hidden sm:inline">Daftar Mentari</span>
      <span class="sm:hidden">Daftar</span>
    </a>
  </div>
</div>

<!-- Main Form Container -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  <div class="max-w-xl mx-auto bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-6 sm:p-8 shadow-xs">
    
    <div class="flex items-center gap-3 pb-5 border-b border-stone-100 dark:border-stone-800 mb-6">
      <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
        </svg>
      </div>
      <div>
        <h2 class="font-heading font-bold text-lg text-stone-900 dark:text-white">
          Jadwal Sesi Pembelajaran Daring
        </h2>
        <p class="text-xs text-stone-500 dark:text-stone-400">
          Sesi aktif akan otomatis muncul pada widget Beranda & halaman Mentari
        </p>
      </div>
    </div>

    <form action="/admin/mentari" method="POST" class="space-y-5">
      
      <!-- Mata Kuliah (Dinamis dari tabel mata_kuliah) -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="matkul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider">
            Mata Kuliah
          </label>
          <a href="/admin/matkul/add" class="text-[11px] text-blue-600 dark:text-blue-400 hover:underline">
            + Tambah Mata Kuliah Baru
          </a>
        </div>
        <select 
          id="matkul" 
          name="matkul" 
          required
          class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
        >
          <option value="">-- Pilih Mata Kuliah --</option>
          <% if (typeof matkul !== 'undefined' && matkul.length > 0) { %>
            <% matkul.forEach(m => { %>
              <option value="<%= m.nama_matkul %>"><%= m.nama_matkul %></option>
            <% }); %>
          <% } else { %>
            <option value="" disabled>Belum ada mata kuliah, silakan tambah matkul terlebih dahulu</option>
          <% } %>
        </select>
      </div>

      <!-- Sesi Pertemuan & Status Sesi -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="pertemuan" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
            Sesi Pertemuan
          </label>
          <input 
            type="text" 
            id="pertemuan" 
            name="pertemuan" 
            required
            placeholder="Contoh: Pertemuan 10" 
            class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
          />
        </div>

        <div>
          <label for="status" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
            Status Sesi
          </label>
          <select 
            id="status" 
            name="status" 
            required
            class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
          >
            <option value="Buka" selected>Buka (Sesi Sedang Berjalan)</option>
            <option value="Tutup">Tutup (Sesi Selesai/Tenggat Lewat)</option>
          </select>
        </div>
      </div>

      <!-- Batas Waktu Sesi -->
      <div>
        <label for="batas_waktu" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
          Batas Waktu Pengisian Mentari
        </label>
        <input 
          type="datetime-local" 
          id="batas_waktu" 
          name="batas_waktu" 
          required
          class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
        />
        <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">
          Waktu penutupan presensi forum diskusi atau batas submit kuis daring.
        </p>
      </div>

      <!-- Tautan Sesi Mentari -->
      <div>
        <label for="link_mentari" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
          TAUTAN SESI MENTARI (OPSIONAL)
        </label>
        <input 
          type="url" 
          id="link_mentari"
          name="link_mentari" 
          placeholder="https://elearning.unpam.ac.id/..." 
          class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
        />
        <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">
          Link langsung menuju halaman presensi, forum, atau kuis di portal Mentari.
        </p>
      </div>

      <!-- Tombol Aksi -->
      <div class="pt-4 border-t border-stone-100 dark:border-stone-800 flex items-center justify-end gap-3">
        <a 
          href="/admin/mentari-list" 
          class="px-4 py-2.5 rounded-xl border border-stone-200 dark:border-stone-700 text-xs font-semibold text-stone-700 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 transition"
        >
          Batal
        </a>
        <button 
          type="submit" 
          class="bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white font-semibold text-sm rounded-xl py-2.5 px-6 transition shadow-xs flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
          <span>Simpan Jadwal Mentari</span>
        </button>
      </div>

    </form>

  </div>
</div>
