<!-- =======================================================================
     ZONA ATAS: Warm Cream / Alabaster (bg-[#F5F4EE] dark:bg-[#1A1918] border-b border-stone-200 dark:border-stone-800)
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  
  <!-- Header Halaman -->
  <div class="max-w-3xl">
    <h1 class="font-heading font-extrabold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-stone-900 dark:text-white">
      <%= (typeof filterMatkul !== 'undefined' && filterMatkul) ? 'Tugas: ' + filterMatkul : 'Informasi Tugas Kuliah' %>
    </h1>
    
    <p class="text-sm text-stone-600 dark:text-stone-400 mt-2 leading-relaxed">
      <%= (typeof filterMatkul !== 'undefined' && filterMatkul) ? 'Daftar penugasan khusus mata kuliah ' + filterMatkul + '.' : 'Daftar tugas aktif, tenggat waktu pengumpulan, dan tautan repositori.' %>
    </p>

    <% if (typeof filterMatkul !== 'undefined' && filterMatkul) { %>
      <div class="mt-4 flex items-center flex-wrap gap-2">
        <span class="text-xs font-medium text-stone-500 dark:text-stone-400">Filter Aktif:</span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 shadow-xs">
          <span><%= filterMatkul %></span>
          <a href="/tugas" class="hover:text-stone-300 dark:hover:text-stone-600 ml-1 font-bold transition" title="Hapus filter">✕</a>
        </span>
        <a href="/tugas" class="text-xs text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:white underline ml-2 transition">
          Tampilkan Semua Mata Kuliah
        </a>
      </div>

      <% const hasDrive = (typeof selectedMatkul !== 'undefined' && selectedMatkul && selectedMatkul.link_materi && selectedMatkul.link_materi.trim() !== ''); %>
      <% const hasKhusus = (typeof tautanMatkulKhusus !== 'undefined' && tautanMatkulKhusus && tautanMatkulKhusus.length > 0); %>
      <% if (hasDrive || hasKhusus) { %>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <% if (hasDrive) { %>
            <a 
              href="<%= selectedMatkul.link_materi %>" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-700 text-stone-800 dark:text-stone-200 hover:bg-stone-50 dark:hover:bg-stone-800 hover:border-stone-300 dark:hover:border-stone-600 transition shadow-xs"
            >
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/>
              </svg>
              <span>Lihat Materi di Google Drive</span>
              <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
              </svg>
            </a>
          <% } %>
          <% if (hasKhusus) { %>
            <% tautanMatkulKhusus.forEach(function(link) { %>
              <a 
                href="<%= link.url %>" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-700 text-stone-800 dark:text-stone-200 hover:bg-stone-50 dark:hover:bg-stone-800 hover:border-stone-300 dark:hover:border-stone-600 transition shadow-xs"
              >
                <% if (link.ikon_svg && link.ikon_svg.trim() !== '') { %>
                  <%- link.ikon_svg %>
                <% } else { %>
                  <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
                  </svg>
                <% } %>
                <span><%= link.nama_tautan %></span>
                <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                </svg>
              </a>
            <% }); %>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>

</div>


<!-- =======================================================================
     ZONA BAWAH: DAFTAR DETAIL TUGAS (2 SECTION: AKTIF & ARSIP)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  
  <div class="max-w-5xl space-y-12">
    
    <!-- =====================================================================
         SECTION 1: TUGAS AKTIF & MENDATANG (DESAIN RINGKASAN)
         ===================================================================== -->
    <section>
      
      <!-- Section Header: Judul di Kiri, Filter & Badge di Kanan -->
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 mb-6">
        <!-- Kiri: Judul dan Deskripsi -->
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-bold text-stone-900 dark:text-white tracking-tight">Tugas Aktif & Mendatang</h2>
            <span class="px-2.5 py-1 bg-blue-600/10 text-blue-500 dark:text-blue-400 rounded-full text-xs font-medium whitespace-nowrap">
              <%= (typeof tugasAktif !== 'undefined' ? tugasAktif.length : 0) %> Aktif
            </span>
          </div>
          <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">Penugasan yang masih aktif dan belum melewati batas waktu pengumpulan</p>
        </div>

        <!-- Kanan: Filter dan Urutkan -->
        <div class="flex flex-row gap-2 w-full md:w-auto lg:justify-end">
          <form method="GET" class="flex flex-row gap-2 w-full md:w-auto">
            <% if (typeof filterMatkul !== 'undefined' && filterMatkul) { %>
              <input type="hidden" name="matkul" value="<%= filterMatkul %>">
            <% } %>

            <% 
              const currentTipe = (typeof filterTipe !== 'undefined' && filterTipe) ? filterTipe : 'Semua';
              const labelTipe = currentTipe === 'Individu' ? 'Individu' : (currentTipe === 'Kelompok' ? 'Kelompok' : 'Semua Tipe');
              
              const currentSort = (typeof urutkan !== 'undefined' && (urutkan === 'terlama' || urutkan === 'terjauh')) || (typeof sort !== 'undefined' && (sort === 'terlama' || sort === 'terjauh')) ? 'terlama' : 'terdekat';
              const labelSort = currentSort === 'terlama' ? 'Deadline Terlama' : 'Deadline Terdekat';
            %>

            <!-- Filter Tipe -->
            <div class="flex items-center gap-2 flex-1 sm:flex-initial">
              <label class="text-xs font-medium text-stone-500 hidden sm:block">Tipe:</label>
              <div class="relative inline-block text-left custom-dropdown-container z-50 w-full sm:w-auto">
                <!-- Input hidden untuk form submit -->
                <input type="hidden" name="tipe" id="input-tipe" value="<%= currentTipe %>">
                
                <button type="button" onclick="toggleCustomDropdown('dropdown-tipe')" class="inline-flex justify-between items-center w-full sm:w-36 px-3 sm:px-4 py-2 bg-white dark:bg-[#1C1C1C] text-gray-900 dark:text-gray-300 border border-gray-300 dark:border-gray-800 rounded-lg text-xs sm:text-sm hover:border-gray-400 dark:hover:border-gray-700 focus:outline-none transition-colors">
                  <span id="label-tipe" class="truncate"><%= labelTipe %></span>
                  <svg class="w-4 h-4 ml-1 sm:ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                
                <div id="dropdown-tipe" class="hidden custom-dropdown-menu absolute left-0 sm:left-auto sm:right-0 mt-2 w-36 bg-white dark:bg-[#1C1C1C] border border-gray-300 dark:border-gray-800 rounded-lg shadow-xl overflow-hidden">
                  <ul class="py-1 text-sm text-gray-900 dark:text-gray-300">
                    <li><button type="button" onclick="document.getElementById('input-tipe').value='Semua'; this.closest('form').submit();" class="w-full text-left px-4 py-2 hover:bg-stone-100 dark:hover:bg-gray-800 hover:text-black dark:hover:text-white transition-colors">Semua Tipe</button></li>
                    <li><button type="button" onclick="document.getElementById('input-tipe').value='Individu'; this.closest('form').submit();" class="w-full text-left px-4 py-2 hover:bg-stone-100 dark:hover:bg-gray-800 hover:text-black dark:hover:text-white transition-colors">Individu</button></li>
                    <li><button type="button" onclick="document.getElementById('input-tipe').value='Kelompok'; this.closest('form').submit();" class="w-full text-left px-4 py-2 hover:bg-stone-100 dark:hover:bg-gray-800 hover:text-black dark:hover:text-white transition-colors">Kelompok</button></li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Filter Urutkan -->
            <div class="flex items-center gap-2 flex-1 sm:flex-initial">
              <label class="text-xs font-medium text-stone-500 hidden sm:block">Urutkan:</label>
              <div class="relative inline-block text-left custom-dropdown-container z-40 w-full sm:w-auto">
                <input type="hidden" name="urutkan" id="input-urutkan" value="<%= currentSort %>">
                
                <button type="button" onclick="toggleCustomDropdown('dropdown-urutkan')" class="inline-flex justify-between items-center w-full sm:w-48 px-3 sm:px-4 py-2 bg-white dark:bg-[#1C1C1C] text-gray-900 dark:text-gray-300 border border-gray-300 dark:border-gray-800 rounded-lg text-xs sm:text-sm hover:border-gray-400 dark:hover:border-gray-700 focus:outline-none transition-colors">
                  <span id="label-urutkan" class="truncate"><%= labelSort %></span>
                  <svg class="w-4 h-4 ml-1 sm:ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                
                <div id="dropdown-urutkan" class="hidden custom-dropdown-menu absolute right-0 mt-2 w-44 sm:w-48 bg-white dark:bg-[#1C1C1C] border border-gray-300 dark:border-gray-800 rounded-lg shadow-xl overflow-hidden">
                  <ul class="py-1 text-sm text-gray-900 dark:text-gray-300">
                    <li><button type="button" onclick="document.getElementById('input-urutkan').value='terdekat'; this.closest('form').submit();" class="w-full text-left px-4 py-2 hover:bg-stone-100 dark:hover:bg-gray-800 hover:text-black dark:hover:text-white transition-colors">Deadline Terdekat</button></li>
                    <li><button type="button" onclick="document.getElementById('input-urutkan').value='terlama'; this.closest('form').submit();" class="w-full text-left px-4 py-2 hover:bg-stone-100 dark:hover:bg-gray-800 hover:text-black dark:hover:text-white transition-colors">Deadline Terlama</button></li>
                  </ul>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- List Kartu Tugas Aktif (Ringkasan) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <% if (typeof tugasAktif !== 'undefined' && tugasAktif.length > 0) { %>
          <% tugasAktif.forEach((t) => { %>
            <% 
              const now = new Date();
              const deadline = new Date(t.batas_waktu);
              const diffTime = deadline - now;
              const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
              
              let pillText = "";
              let pillColor = "";
              
              if (t.status === 'Selesai') {
                pillText = "Selesai";
                pillColor = "bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-300";
              } else if (diffDays < 0) {
                pillText = "Lewat Tenggat";
                pillColor = "bg-rose-500/10 text-rose-400";
              } else if (diffDays === 0) {
                pillText = "Hari Ini";
                pillColor = "bg-red-500/10 text-red-400 font-semibold";
              } else if (diffDays <= 2) {
                pillText = "H-" + diffDays;
                pillColor = "bg-red-500/10 text-red-400 font-semibold";
              } else if (diffDays <= 5) {
                pillText = diffDays + " Hari Lagi";
                pillColor = "bg-amber-500/10 text-amber-400";
              } else {
                pillText = diffDays + " Hari Lagi";
                pillColor = "bg-emerald-500/10 text-emerald-400";
              }
            %>
            
            <!-- Kartu Tugas Ringkasan (Seluruh Card Clickable ke Detail) -->
            <div 
              onclick="window.location.href='/tugas/<%= t.id %>'" 
              class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-5 flex flex-col justify-between shadow-xs transition hover:border-stone-400 dark:hover:border-stone-700 cursor-pointer group"
            >
              <div>
                <!-- Baris Header Kartu Tugas: Matkul, Tipe, Status Deadline -->
                <div class="flex items-start justify-between gap-2 mb-4">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 text-xs font-bold px-2 py-0.5 rounded-md">
                      <%= t.matkul %>
                    </span>
                    <span class="text-stone-600 dark:text-stone-400 text-xs font-medium px-2 py-0.5 rounded-md bg-stone-100 dark:bg-stone-800/60">
                      <%= t.tipe %>
                    </span>
                  </div>

                  <!-- Badge Status Deadline -->
                  <span class="inline-flex items-center text-xs px-2.5 py-0.5 rounded-full <%= pillColor %> font-medium tabular-nums shadow-xs whitespace-nowrap">
                    <%= pillText %>
                  </span>
                </div>

                <!-- Judul Tugas Ringkasan -->
                <h3 class="font-heading font-bold text-base sm:text-lg text-stone-900 dark:text-white transition-colors line-clamp-2 mt-3 leading-snug">
                  <a href="/tugas/<%= t.id %>" onclick="event.stopPropagation();">
                    <%= t.judul %>
                  </a>
                </h3>
              </div>

              <!-- Footer: Batas Waktu & Tombol Lihat Detail -->
              <div class="flex items-center justify-between gap-2 mt-5 pt-4 border-t border-stone-100 dark:border-stone-800">
                <div class="flex items-center gap-1.5 text-xs text-stone-500 dark:text-stone-400 tabular-nums">
                  <svg class="w-4 h-4 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span><%= t.batas_waktu ? t.batas_waktu.replace('T', ' ') : '-' %></span>
                </div>

                <a 
                  href="/tugas/<%= t.id %>" 
                  onclick="event.stopPropagation();"
                  class="inline-flex items-center justify-center gap-1 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-stone-100 dark:bg-[#252525] border border-stone-300 dark:border-gray-700 rounded-lg hover:bg-stone-200 dark:hover:bg-gray-700 hover:text-black dark:hover:text-white transition-colors"
                >
                  Lihat Detail
                </a>
              </div>
            </div>

          <% }); %>
        <% } else { %>
          <div class="col-span-full p-10 text-center border border-dashed border-stone-200 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A]">
            <svg class="w-10 h-10 mx-auto text-emerald-500/80 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-stone-800 dark:text-stone-200 font-semibold text-sm">Tidak Ada Tugas Aktif</p>
            <p class="text-xs text-stone-400 mt-1">Tidak ada tugas yang sesuai dengan kriteria filter saat ini atau semua tugas telah diarsipkan.</p>
          </div>
        <% } %>
      </div>

    </section>


    <!-- =====================================================================
         SECTION 2: RIWAYAT & ARSIP TUGAS (<details> DROPDOWN - LIST BARIS MINI)
         ===================================================================== -->
    <details class="group mt-12 pt-8 border-t border-stone-200/80 dark:border-stone-800">
      
      <!-- Summary Trigger -->
      <summary class="flex items-center justify-between cursor-pointer list-none py-2 select-none group-open:mb-4 transition">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-500 dark:text-stone-400 flex items-center justify-center transition group-open:rotate-90">
            <svg class="w-4 h-4 transition duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
          </div>
          <div>
            <h2 class="font-heading font-extrabold text-xl sm:text-2xl text-stone-900 dark:text-white tracking-tight">
              Arsip Tugas
            </h2>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-stone-100 text-stone-700 dark:bg-stone-800 dark:text-stone-300 tabular-nums whitespace-nowrap">
            <%= (typeof tugasArsip !== 'undefined' ? tugasArsip.length : 0) %> Diarsipkan
          </span>
        </div>
      </summary>

      <!-- Desain Arsip Mini: List Baris (Flexbox Horizontal) dengan Padding Tipis -->
      <div class="border border-stone-200 dark:border-stone-800 rounded-2xl overflow-hidden bg-white dark:bg-[#1C1B1A] divide-y divide-stone-100 dark:divide-stone-800 shadow-xs">
        <% if (typeof tugasArsip !== 'undefined' && tugasArsip.length > 0) { %>
          <% tugasArsip.forEach(t => { %>
            <div class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-stone-50 dark:hover:bg-stone-800/40 transition">
              
              <!-- Judul Matkul & Nama Tugas -->
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex-shrink-0">
                  <%= t.matkul %>
                </span>
                <span class="text-xs font-medium text-stone-400 dark:text-stone-500 font-mono hidden md:inline">
                  <%= t.tipe %>
                </span>
                <a href="/tugas/<%= t.id %>" class="text-sm font-medium text-stone-900 dark:text-stone-100 hover:underline truncate">
                  <%= t.judul %>
                </a>
              </div>

              <!-- Tanggal, Badge "Selesai", dan Ikon Drive -->
              <div class="flex items-center gap-2.5 flex-shrink-0">
                <span class="text-xs text-stone-400 dark:text-stone-500 tabular-nums hidden sm:inline">
                  <%= t.batas_waktu ? t.batas_waktu.slice(0, 10) : '' %>
                </span>
                
                <span class="inline-flex items-center text-[11px] px-2.5 py-0.5 rounded-full font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400">
                  Selesai
                </span>

                <% if (t.link_drive && t.link_drive.trim() !== '') { %>
                  <a 
                    href="<%= t.link_drive %>" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="p-1 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition" 
                    title="Buka Drive"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                    </svg>
                  </a>
                <% } %>
              </div>

            </div>
          <% }); %>
        <% } else { %>
          <div class="p-8 text-center text-xs text-stone-400 italic">
            Belum ada riwayat tugas yang selesai atau lampau.
          </div>
        <% } %>
      </div>

    </details>

  </div>

</div>

<script>
  function toggleCustomDropdown(id) {
    document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
      if (menu.id !== id) menu.classList.add('hidden');
    });
    document.getElementById(id).classList.toggle('hidden');
  }

  // Menutup dropdown jika user mengklik di luar area menu
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.custom-dropdown-container')) {
      document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
        menu.classList.add('hidden');
      });
    }
  });
</script>
