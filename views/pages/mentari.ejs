<!-- =======================================================================
     ZONA ATAS: Header & Ringkasan (bg-[#F5F4EE] dark:bg-[#1A1918] border-b border-stone-200 dark:border-stone-800)
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  
  <div class="max-w-6xl mx-auto">
    
    <!-- Judul & Deskripsi Halaman -->
    <div class="max-w-2xl">
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-stone-900 dark:text-white">
        Jadwal Mentari E-Learning
      </h1>
      
      <p class="text-sm text-stone-600 dark:text-stone-400 mt-2 leading-relaxed">
        Jadwal sesi diskusi, kuis, dan materi perkuliahan daring di portal Mentari UNPAM.
      </p>
    </div>

  </div>

</div>


<!-- =======================================================================
     ZONA BAWAH: GRID KARTU SESI MENTARI (2 SECTION: AKTIF & ARSIP)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  
  <div class="max-w-6xl mx-auto space-y-12">
    
    <!-- =====================================================================
         SECTION 1: SESI MENTARI BERJALAN
         ===================================================================== -->
    <section>
      
      <!-- Sub-header Section 1 -->
      <div class="flex items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="font-heading font-extrabold text-xl sm:text-2xl text-stone-900 dark:text-white tracking-tight">
            Sesi Mentari Berjalan
          </h2>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-0.5">
            Sesi absensi, forum diskusi, dan kuis daring UNPAM yang sedang dibuka
          </p>
        </div>

        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 tabular-nums">
          <%= (typeof mentariAktif !== 'undefined' ? mentariAktif.length : 0) %> Aktif
        </span>
      </div>

      <!-- Grid Kartu Sesi Aktif -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (typeof mentariAktif !== 'undefined' && mentariAktif.length > 0) { %>
          <% mentariAktif.forEach(m => { %>
            <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-5 flex flex-col justify-between shadow-xs transition hover:border-stone-400 dark:hover:border-stone-700">
              <div>
                <!-- Header Kartu: badge pertemuan & status -->
                <div class="flex items-center justify-between gap-2">
                  <span class="bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 text-xs px-2.5 py-1 rounded-md font-semibold">
                    <%= m.pertemuan %>
                  </span>
                  <span class="bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400 text-xs px-2.5 py-1 rounded-full font-medium inline-flex items-center">
                    <span>Sedang Buka</span>
                  </span>
                </div>

                <!-- Body Kartu -->
                <h3 class="font-heading font-bold text-lg text-stone-900 dark:text-white mt-3 leading-snug">
                  <%= m.matkul %>
                </h3>

                <!-- Checklist Instruksi Standar Perkuliahan -->
                <ul class="text-sm text-stone-600 dark:text-stone-400 mt-4 space-y-1.5">
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs">✓</span>
                    <span>Absensi Kehadiran Online</span>
                  </li>
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs">✓</span>
                    <span>Unduh Modul & Materi Ajar</span>
                  </li>
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs">✓</span>
                    <span>Respon Forum Diskusi Perkuliahan</span>
                  </li>
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs">✓</span>
                    <span>Pengerjaan Kuis / Latihan</span>
                  </li>
                </ul>
              </div>

              <!-- Footer Kartu -->
              <div>
                <div class="border-t border-stone-100 dark:border-stone-800 my-4"></div>
                
                <div class="flex items-center gap-1.5 text-xs text-stone-600 dark:text-stone-400 font-medium tabular-nums">
                  <svg class="w-3.5 h-3.5 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span>Batas Waktu: <%= m.batas_waktu ? m.batas_waktu.replace('T', ' ') : '-' %></span>
                </div>

                <a 
                  href="<%= (m.link_mentari && m.link_mentari.trim() !== '') ? m.link_mentari : 'https://elearning.unpam.ac.id/' %>" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 rounded-xl px-4 py-2 text-xs sm:text-sm font-semibold text-center w-full mt-3 transition inline-flex items-center justify-center gap-1.5 shadow-xs"
                >
                  <span>Cek Mentari UNPAM ↗</span>
                </a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-span-full p-10 text-center border border-dashed border-stone-200 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A]">
            <svg class="w-10 h-10 mx-auto text-emerald-500/80 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-stone-800 dark:text-stone-200 font-semibold text-sm">Tidak Ada Sesi Mentari Berjalan</p>
            <p class="text-xs text-stone-400 mt-1">Saat ini tidak ada sesi e-learning aktif yang sedang dibuka.</p>
          </div>
        <% } %>
      </div>

    </section>


    <!-- =====================================================================
         SECTION 2: ARSIP JADWAL E-LEARNING (<details> DROPDOWN)
         ===================================================================== -->
    <details class="group mt-12 pt-8 border-t border-stone-200/80 dark:border-stone-800">
      
      <!-- Summary Trigger -->
      <summary class="flex items-center justify-between cursor-pointer list-none py-2 select-none group-open:mb-6 transition">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-500 dark:text-stone-400 flex items-center justify-center transition group-open:rotate-90">
            <svg class="w-4 h-4 transition duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
          </div>
          <div>
            <h2 class="font-heading font-extrabold text-xl sm:text-2xl text-stone-900 dark:text-white tracking-tight">
              Arsip Jadwal E-Learning
            </h2>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-stone-100 text-stone-700 dark:bg-stone-800 dark:text-stone-300 tabular-nums">
            <%= (typeof mentariArsip !== 'undefined' ? mentariArsip.length : 0) %> Diarsipkan
          </span>
        </div>
      </summary>

      <!-- Grid Kartu Sesi Arsip -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
        <% if (typeof mentariArsip !== 'undefined' && mentariArsip.length > 0) { %>
          <% mentariArsip.forEach(m => { %>
            <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/70 dark:border-stone-800/80 rounded-2xl p-5 flex flex-col justify-between opacity-80 hover:opacity-100 transition duration-200 shadow-xs hover:border-stone-300 dark:hover:border-stone-600">
              <div>
                <!-- Header Kartu: badge pertemuan & status arsip -->
                <div class="flex items-center justify-between gap-2">
                  <span class="bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400 text-xs px-2.5 py-1 rounded-md font-medium">
                    <%= m.pertemuan %>
                  </span>
                  <span class="bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400 text-xs px-2.5 py-1 rounded-full font-medium inline-flex items-center">
                    <span>Tenggat Ditutup</span>
                  </span>
                </div>

                <!-- Body Kartu -->
                <h3 class="font-heading font-bold text-lg text-stone-700 dark:text-stone-200 mt-3 leading-snug">
                  <%= m.matkul %>
                </h3>

                <!-- Checklist Sesi Lampau -->
                <ul class="text-sm text-stone-500 dark:text-stone-400 mt-4 space-y-1.5">
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-stone-400 dark:text-stone-500 font-bold text-xs">✓</span>
                    <span>Absensi Kehadiran Online</span>
                  </li>
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-stone-400 dark:text-stone-500 font-bold text-xs">✓</span>
                    <span>Unduh Modul & Materi Ajar</span>
                  </li>
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-stone-400 dark:text-stone-500 font-bold text-xs">✓</span>
                    <span>Respon Forum Diskusi Perkuliahan</span>
                  </li>
                  <li class="flex items-center gap-2 text-xs">
                    <span class="text-stone-400 dark:text-stone-500 font-bold text-xs">✓</span>
                    <span>Pengerjaan Kuis / Latihan</span>
                  </li>
                </ul>
              </div>

              <!-- Footer Kartu: Tombol Pudar / Abu-abu Sesuai Instruksi -->
              <div>
                <div class="border-t border-stone-100 dark:border-stone-800 my-4"></div>
                
                <div class="flex items-center gap-1.5 text-xs text-stone-500 dark:text-stone-400 font-medium tabular-nums">
                  <svg class="w-3.5 h-3.5 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span>Batas Waktu: <%= m.batas_waktu ? m.batas_waktu.replace('T', ' ') : '-' %></span>
                </div>

                <!-- Tombol Cek Mentari UNPAM Pudar / Abu-abu (dimmed style) -->
                <a 
                  href="<%= (m.link_mentari && m.link_mentari.trim() !== '') ? m.link_mentari : 'https://elearning.unpam.ac.id/' %>" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="border border-stone-200/80 dark:border-stone-800 text-stone-500 dark:text-stone-400 hover:text-stone-700 dark:hover:text-stone-300 hover:bg-stone-100/60 dark:hover:bg-stone-800/40 rounded-xl px-4 py-2 text-xs sm:text-sm font-medium text-center w-full mt-3 transition inline-flex items-center justify-center gap-1.5"
                >
                  <span>Cek Mentari UNPAM ↗</span>
                </a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-span-full p-10 text-center border border-dashed border-stone-200 dark:border-stone-800 rounded-2xl bg-white dark:bg-[#1C1B1A]">
            <p class="text-stone-600 dark:text-stone-400 font-semibold text-sm">Belum Ada Arsip Sesi Mentari</p>
            <p class="text-xs text-stone-400 mt-1">Saat ini belum ada riwayat sesi e-learning yang ditutup atau lampau.</p>
          </div>
        <% } %>
      </div>

    </details>

  </div>

</div>
