<!-- Header & Back Navigation -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  <div class="max-w-2xl mx-auto flex items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 text-stone-700 dark:text-stone-300 mb-2 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
        <span>Formulir Terpisah • Kurikulum Kelas</span>
      </div>
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl tracking-tight text-stone-900 dark:text-white">
        Tambah Mata Kuliah
      </h1>
      <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-1">
        Daftarkan mata kuliah baru agar otomatis tersedia di pilihan formulir tugas dan Mentari.
      </p>
    </div>

    <!-- Tombol Kembali ke Daftar -->
    <a 
      href="/admin/matkul-list" 
      class="inline-flex items-center gap-2 text-xs font-semibold text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white border border-stone-200 dark:border-stone-700 px-3.5 py-2 rounded-xl bg-white dark:bg-[#1C1B1A] hover:bg-stone-50 dark:hover:bg-stone-800 transition shadow-xs flex-shrink-0"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      <span class="hidden sm:inline">Daftar Matkul</span>
      <span class="sm:hidden">Daftar</span>
    </a>
  </div>
</div>

<!-- Main Form Container -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  <div class="max-w-xl mx-auto bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-6 sm:p-8 shadow-xs">
    
    <div class="flex items-center gap-3 pb-5 border-b border-stone-100 dark:border-stone-800 mb-6">
      <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
        </svg>
      </div>
      <div>
        <h2 class="font-heading font-bold text-lg text-stone-900 dark:text-white">
          Data Mata Kuliah Baru
        </h2>
        <p class="text-xs text-stone-500 dark:text-stone-400">
          Entri ini akan dijadikan opsi pilihan di form tugas dan Mentari
        </p>
      </div>
    </div>

    <form action="/admin/matkul" method="POST" class="space-y-5">
      
      <!-- Nama Mata Kuliah -->
      <div>
        <label for="nama_matkul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
          Nama Mata Kuliah
        </label>
        <input 
          type="text" 
          id="nama_matkul" 
          name="nama_matkul" 
          required
          placeholder="Contoh: Pemrograman Mobile Lanjut" 
          class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
        />
      </div>

      <!-- SKS & Hari -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="sks" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
            Bobot SKS
          </label>
          <input 
            type="number" 
            id="sks" 
            name="sks" 
            min="1" 
            max="6" 
            value="3"
            required
            class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm tabular-nums focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
          />
        </div>

        <div>
          <label for="hari" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
            Hari Perkuliahan
          </label>
          <input 
            type="text" 
            id="hari" 
            name="hari" 
            required
            placeholder="Contoh: Rabu" 
            class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
          />
        </div>
      </div>

      <!-- Dosen Pengampu -->
      <div>
        <label for="dosen" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
          Dosen Pengampu
        </label>
        <input 
          type="text" 
          id="dosen" 
          name="dosen" 
          required
          placeholder="Contoh: ANIS MIRZA S.Kom, M.Kom" 
          class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
        />
      </div>

      <!-- Tautan Materi / Google Drive -->
      <div>
        <label for="link_materi" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
          Tautan Materi / Google Drive (Opsional)
        </label>
        <input 
          type="url" 
          id="link_materi" 
          name="link_materi" 
          placeholder="https://drive.google.com/drive/folders/..." 
          class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
        />
        <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">
          Folder Google Drive materi perkuliahan untuk diakses mahasiswa di portal.
        </p>
      </div>

      <!-- Tombol Aksi -->
      <div class="pt-4 border-t border-stone-100 dark:border-stone-800 flex items-center justify-end gap-3">
        <a 
          href="/admin/matkul-list" 
          class="px-4 py-2.5 rounded-xl border border-stone-200 dark:border-stone-700 text-xs font-semibold text-stone-700 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 transition"
        >
          Batal
        </a>
        <button 
          type="submit" 
          class="bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white font-semibold text-sm rounded-xl py-2.5 px-6 transition shadow-xs flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
          <span>Simpan Mata Kuliah</span>
        </button>
      </div>

    </form>

  </div>
</div>
