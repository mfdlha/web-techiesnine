<!-- =======================================================================
     ZONA ATAS: Header Edit (bg-[#F5F4EE] dark:bg-[#1A1918] border-b border-stone-200 dark:border-stone-800)
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  <div class="max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400 mb-3" aria-label="Breadcrumb">
      <a href="/admin" class="hover:text-stone-900 dark:hover:text-white transition flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
        </svg>
        <span>Dashboard</span>
      </a>
      <span>/</span>
      <a href="/admin/<%= type %>-list" class="hover:text-stone-900 dark:hover:text-white transition uppercase tracking-wider font-medium">
        Kelola <%= type === 'tugas' ? 'Tugas' : (type === 'kas' ? 'Kas' : (type === 'mentari' ? 'Mentari' : (type === 'matkul' ? 'Mata Kuliah' : 'Tautan Cepat'))) %>
      </a>
      <span>/</span>
      <span class="font-mono text-stone-400">#<%= data.id %></span>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-heading font-extrabold text-2xl sm:text-3xl tracking-tight text-stone-900 dark:text-white">
          Edit <%= type === 'tugas' ? 'Tugas Kuliah' : (type === 'kas' ? 'Transaksi Kas' : (type === 'mentari' ? 'Jadwal Mentari' : (type === 'matkul' ? 'Mata Kuliah' : 'Tautan Cepat'))) %>
        </h1>
        <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-1.5">
          Perbarui informasi data entitas <span class="font-semibold font-mono text-stone-800 dark:text-stone-200">#<%= data.id %></span> yang tersimpan di database Turso.
        </p>
      </div>

      <a 
        href="/admin/<%= type %>-list" 
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 transition shadow-xs self-start sm:self-auto"
      >
        <svg class="w-4 h-4 text-stone-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
        </svg>
        <span>Kembali ke Daftar</span>
      </a>
    </div>
  </div>
</div>

<!-- =======================================================================
     ZONA FORM EDIT: Card Container (bg-white dark:bg-[#121211] p-6 lg:p-8)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 flex-1 transition-colors">
  <div class="max-w-3xl">

    <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-6 sm:p-8 shadow-xs">
      
      <!-- Header Card -->
      <div class="flex items-center gap-3 pb-5 mb-6 border-b border-stone-100 dark:border-stone-800">
        <div class="w-10 h-10 rounded-xl bg-stone-100 dark:bg-stone-800 flex items-center justify-center text-stone-700 dark:text-stone-300 flex-shrink-0">
          <% if (type === 'tugas') { %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          <% } else if (type === 'kas') { %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
            </svg>
          <% } else if (type === 'mentari') { %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
            </svg>
          <% } else if (type === 'matkul') { %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
            </svg>
          <% } else if (type === 'tautan') { %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
            </svg>
          <% } %>
        </div>
        <div>
          <h2 class="font-heading font-bold text-lg text-stone-900 dark:text-white">
            Formulir Perubahan Data
          </h2>
          <p class="text-xs text-stone-500 dark:text-stone-400">
            ID Record: <span class="font-mono font-semibold text-stone-700 dark:text-stone-300">#<%= data.id %></span>
          </p>
        </div>
      </div>

      <!-- Main Form -->
      <form action="/admin/<%= type %>/edit/<%= data.id %>" method="POST" class="space-y-5">
        
        <!-- ==============================================
             KASUS 1: FORM EDIT TUGAS
             ============================================== -->
        <% if (type === 'tugas') { %>
          
          <!-- Mata Kuliah -->
          <div>
            <label for="matkul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Mata Kuliah
            </label>
            <select 
              id="matkul" 
              name="matkul" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="">-- Pilih Mata Kuliah --</option>
              <% if (typeof matkul !== 'undefined' && matkul.length > 0) { %>
                <% matkul.forEach(m => { %>
                  <option value="<%= m.nama_matkul %>" <%= data.matkul === m.nama_matkul ? 'selected' : '' %>><%= m.nama_matkul %></option>
                <% }); %>
              <% } %>
              <% if (data.matkul && (typeof matkul === 'undefined' || !matkul.some(m => m.nama_matkul === data.matkul))) { %>
                <option value="<%= data.matkul %>" selected><%= data.matkul %></option>
              <% } %>
            </select>
          </div>

          <!-- Judul Tugas -->
          <div>
            <label for="judul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Judul Tugas
            </label>
            <input 
              type="text" 
              id="judul" 
              name="judul" 
              required
              value="<%= data.judul || '' %>"
              placeholder="Contoh: REST API Express & Database Turso" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Tipe Tugas -->
          <div>
            <label for="tipe" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Tipe Tugas
            </label>
            <select 
              id="tipe" 
              name="tipe" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="Individu" <%= data.tipe === 'Individu' ? 'selected' : '' %>>Individu (Tugas Mandiri)</option>
              <option value="Kelompok" <%= data.tipe === 'Kelompok' ? 'selected' : '' %>>Kelompok (Teamwork)</option>
            </select>
          </div>

          <!-- Status Tugas (select: Aktif / Selesai) -->
          <div>
            <label for="status" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Status Tugas
            </label>
            <select 
              id="status" 
              name="status" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="Aktif" <%= (!data.status || data.status === 'Aktif') ? 'selected' : '' %>>Aktif (Sedang Berjalan)</option>
              <option value="Selesai" <%= data.status === 'Selesai' ? 'selected' : '' %>>Selesai (Sudah Berakhir / Arsip)</option>
            </select>
          </div>

          <!-- Batas Waktu -->
          <div>
            <label for="batas_waktu" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Tenggat Waktu (Batas Pengumpulan)
            </label>
            <% 
              let formattedBatasWaktu = '';
              if (data.batas_waktu) {
                formattedBatasWaktu = data.batas_waktu.length >= 16 ? data.batas_waktu.slice(0, 16) : data.batas_waktu;
              }
            %>
            <input 
              type="datetime-local" 
              id="batas_waktu" 
              name="batas_waktu" 
              required
              value="<%= formattedBatasWaktu %>"
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Link Drive -->
          <div>
            <label for="link_drive" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Tautan Folder Drive Pengumpulan
            </label>
            <input 
              type="url" 
              id="link_drive" 
              name="link_drive" 
              value="<%= data.link_drive || '' %>"
              placeholder="https://drive.google.com/drive/folders/..." 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Deskripsi -->
          <div>
            <label for="deskripsi" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Deskripsi & Instruksi
            </label>
            <div class="mb-2 flex flex-wrap gap-2">
              <button type="button" onclick="insertMarkdown('image')" class="inline-flex items-center gap-1 text-xs bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-1.5 rounded-md border border-gray-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                Gambar
              </button>
              <button type="button" onclick="insertMarkdown('link')" class="inline-flex items-center gap-1 text-xs bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-1.5 rounded-md border border-gray-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                Dokumen / Link
              </button>
              <button type="button" onclick="insertMarkdown('bold')" class="inline-flex items-center gap-1 text-xs bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-1.5 rounded-md border border-gray-600 font-bold transition-colors">
                B
              </button>
              <button type="button" onclick="insertMarkdown('list')" class="inline-flex items-center gap-1 text-xs bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-1.5 rounded-md border border-gray-600 transition-colors">
                List
              </button>
            </div>
            <textarea 
              id="deskripsi" 
              name="deskripsi" 
              rows="4" 
              placeholder="Sertakan instruksi pengerjaan..."
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            ><%= data.deskripsi || '' %></textarea>
          </div>

        <!-- ==============================================
             KASUS 2: FORM EDIT KAS
             ============================================== -->
        <% } else if (type === 'kas') { %>
          
          <!-- Tanggal -->
          <div>
            <label for="tanggal" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Tanggal Transaksi
            </label>
            <input 
              type="date" 
              id="tanggal" 
              name="tanggal" 
              required
              value="<%= data.tanggal || '' %>"
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Keterangan -->
          <div>
            <label for="keterangan" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Keterangan Transaksi
            </label>
            <input 
              type="text" 
              id="keterangan" 
              name="keterangan" 
              required
              value="<%= data.keterangan || '' %>"
              placeholder="Contoh: Iuran Kas Minggu 10 / Beli Spidol" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Jenis -->
          <div>
            <label for="jenis" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Jenis Mutasi
            </label>
            <select 
              id="jenis" 
              name="jenis" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="Pemasukan" <%= (data.jenis && data.jenis.toLowerCase() === 'pemasukan') || (data.keterangan && data.keterangan.toLowerCase().includes('iuran')) ? 'selected' : '' %>>Pemasukan (Uang Masuk / Iuran)</option>
              <option value="Pengeluaran" <%= (data.jenis && data.jenis.toLowerCase() === 'pengeluaran') && !(data.keterangan && data.keterangan.toLowerCase().includes('iuran')) ? 'selected' : '' %>>Pengeluaran (Belanja / Operasional)</option>
            </select>
          </div>

          <!-- Nominal -->
          <div>
            <label for="nominal" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Nominal (Rupiah murni tanpa titik)
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-xs font-bold text-stone-400 pointer-events-none">
                Rp
              </span>
              <input 
                type="number" 
                id="nominal" 
                name="nominal" 
                min="0"
                step="1000"
                required
                value="<%= data.nominal || 0 %>"
                placeholder="20000" 
                class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl pl-10 pr-3.5 py-2.5 text-sm tabular-nums focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
              />
            </div>
            <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">
              Ketik angka saja, contoh: 50000
            </p>
          </div>

        <!-- ==============================================
             KASUS 3: FORM EDIT MENTARI
             ============================================== -->
        <% } else if (type === 'mentari') { %>
          
          <!-- Mata Kuliah -->
          <div>
            <label for="matkul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Mata Kuliah
            </label>
            <select 
              id="matkul" 
              name="matkul" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="">-- Pilih Mata Kuliah --</option>
              <% if (typeof matkul !== 'undefined' && matkul.length > 0) { %>
                <% matkul.forEach(m => { %>
                  <option value="<%= m.nama_matkul %>" <%= data.matkul === m.nama_matkul ? 'selected' : '' %>><%= m.nama_matkul %></option>
                <% }); %>
              <% } %>
              <% if (data.matkul && (typeof matkul === 'undefined' || !matkul.some(m => m.nama_matkul === data.matkul))) { %>
                <option value="<%= data.matkul %>" selected><%= data.matkul %></option>
              <% } %>
            </select>
          </div>

          <!-- Sesi Pertemuan -->
          <div>
            <label for="pertemuan" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Sesi Pertemuan
            </label>
            <input 
              type="text" 
              id="pertemuan" 
              name="pertemuan" 
              required
              value="<%= data.pertemuan || '' %>"
              placeholder="Contoh: Pertemuan 10" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Status Sesi -->
          <div>
            <label for="status" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Status Sesi
            </label>
            <select 
              id="status" 
              name="status" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="Buka" <%= data.status === 'Buka' ? 'selected' : '' %>>Buka (Sedang Buka)</option>
              <option value="Tutup" <%= data.status === 'Tutup' ? 'selected' : '' %>>Tutup (Tenggat Ditutup)</option>
            </select>
          </div>

          <!-- Batas Waktu -->
          <div>
            <label for="batas_waktu" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Batas Waktu Sesi Ditutup
            </label>
            <% 
              let formattedBatasWaktuMentari = '';
              if (data.batas_waktu) {
                formattedBatasWaktuMentari = data.batas_waktu.length >= 16 ? data.batas_waktu.slice(0, 16) : data.batas_waktu;
              }
            %>
            <input 
              type="datetime-local" 
              id="batas_waktu" 
              name="batas_waktu" 
              required
              value="<%= formattedBatasWaktuMentari %>"
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Tautan Sesi Mentari -->
          <div>
            <label for="link_mentari" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              TAUTAN SESI MENTARI (OPSIONAL)
            </label>
            <input 
              type="url" 
              id="link_mentari"
              name="link_mentari" 
              value="<%= data.link_mentari || '' %>"
              placeholder="https://elearning.unpam.ac.id/..." 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
            <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">
              Link langsung menuju halaman presensi, forum, atau kuis di portal Mentari.
            </p>
          </div>

        <!-- ==============================================
             KASUS 4: FORM EDIT MATA KULIAH
             ============================================== -->
        <% } else if (type === 'matkul') { %>

          <!-- Nama Mata Kuliah -->
          <div>
            <label for="nama_matkul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Nama Mata Kuliah
            </label>
            <input 
              type="text" 
              id="nama_matkul" 
              name="nama_matkul" 
              required
              value="<%= data.nama_matkul || '' %>"
              placeholder="Contoh: Pemrograman Web" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- SKS & Hari -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="sks" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
                Bobot SKS
              </label>
              <input 
                type="number" 
                id="sks" 
                name="sks" 
                min="1" 
                max="6" 
                value="<%= data.sks || 3 %>"
                required
                class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm tabular-nums focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
              />
            </div>

            <div>
              <label for="hari" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
                Hari Perkuliahan
              </label>
              <input 
                type="text" 
                id="hari" 
                name="hari" 
                required
                value="<%= data.hari || '' %>"
                placeholder="Contoh: Rabu" 
                class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
              />
            </div>
          </div>

          <!-- Dosen Pengampu -->
          <div>
            <label for="dosen" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Dosen Pengampu
            </label>
            <input 
              type="text" 
              id="dosen" 
              name="dosen" 
              required
              value="<%= data.dosen || '' %>"
              placeholder="Contoh: ANIS MIRZA S.Kom, M.Kom" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Tautan Materi / Google Drive -->
          <div>
            <label for="link_materi" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Tautan Materi / Google Drive (Opsional)
            </label>
            <input 
              type="url" 
              id="link_materi" 
              name="link_materi" 
              value="<%= data.link_materi || '' %>"
              placeholder="https://drive.google.com/drive/folders/..." 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
            <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">
              Folder Google Drive materi perkuliahan untuk diakses mahasiswa di portal.
            </p>
          </div>

        <!-- ==============================================
             KASUS 5: FORM EDIT TAUTAN CEPAT
             ============================================== -->
        <% } else if (type === 'tautan') { %>

          <!-- Nama Tautan -->
          <div>
            <label for="nama_tautan" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Nama Tautan
            </label>
            <input 
              type="text" 
              id="nama_tautan" 
              name="nama_tautan" 
              required
              value="<%= data.nama_tautan || '' %>"
              placeholder="Contoh: Portal SIAKAD UNPAM" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- URL Tujuan -->
          <div>
            <label for="url" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              URL Web / Tautan Tujuan
            </label>
            <input 
              type="url" 
              id="url" 
              name="url" 
              required
              value="<%= data.url || '' %>"
              placeholder="https://siakad.unpam.ac.id" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            />
          </div>

          <!-- Kode Ikon SVG -->
          <div>
            <label for="ikon_svg" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Kode Ikon SVG <span class="text-stone-400 font-normal lowercase">(opsional)</span>
            </label>
            <textarea 
              id="ikon_svg" 
              name="ikon_svg" 
              rows="3"
              placeholder='<svg class="w-4 h-4 text-sky-500 flex-shrink-0" fill="none" stroke="currentColor" ...>...</svg>'
              class="w-full font-mono text-xs bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            ><%= data.ikon_svg || '' %></textarea>
            <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">Kosongkan jika ingin menggunakan ikon tautan standar bawaan.</p>
          </div>

          <!-- Target Penempatan -->
          <div>
            <label for="target_matkul" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Target Penempatan
            </label>
            <select 
              id="target_matkul" 
              name="target_matkul" 
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="Global" <%= (typeof data !== 'undefined' && data.target_matkul === 'Global') ? 'selected' : '' %>>Global (Muncul di Sidebar)</option>
              <% if (typeof mataKuliah !== 'undefined') { %>
                <% mataKuliah.forEach(function(mk) { %>
                  <option value="<%= mk.nama_matkul %>" <%= (typeof data !== 'undefined' && data.target_matkul === mk.nama_matkul) ? 'selected' : '' %>>Khusus Mata Kuliah: <%= mk.nama_matkul %></option>
                <% }); %>
              <% } %>
            </select>
            <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-1">Pilih "Global" agar muncul di sidebar semua halaman, atau pilih matkul tertentu agar muncul di halaman Tugas matkul terkait.</p>
          </div>

          <!-- Status -->
          <div>
            <label for="status" class="block text-xs font-semibold text-stone-700 dark:text-stone-300 uppercase tracking-wider mb-1.5">
              Status Tampilan
            </label>
            <select 
              id="status" 
              name="status" 
              required
              class="w-full bg-stone-50 dark:bg-[#121211] border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-stone-900 dark:focus:ring-stone-300 focus:border-stone-900 dark:focus:border-stone-300 transition"
            >
              <option value="Aktif" <%= data.status === 'Aktif' ? 'selected' : '' %>>Aktif (Tampilkan di Sidebar)</option>
              <option value="Sembunyi" <%= data.status === 'Sembunyi' ? 'selected' : '' %>>Sembunyi (Arsipkan)</option>
            </select>
          </div>

        <% } %>

        <!-- Action Buttons (Simpan Perubahan & Batal) -->
        <div class="pt-5 flex flex-col-reverse sm:flex-row items-center justify-end gap-3 border-t border-stone-100 dark:border-stone-800">
          <a 
            href="/admin/<%= type %>-list" 
            class="w-full sm:w-auto px-5 py-2.5 rounded-xl border border-stone-200 dark:border-stone-700 text-xs sm:text-sm font-semibold text-stone-700 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 transition text-center shadow-xs"
          >
            Batal
          </a>
          <button 
            type="submit" 
            class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white text-xs sm:text-sm font-semibold transition shadow-xs flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
            <span>Simpan Perubahan</span>
          </button>
        </div>

      </form>

    </div>

  </div>
</div>

<script>
function insertMarkdown(type) {
  const textarea = document.querySelector('textarea[name="deskripsi"]');
  if (!textarea) return;

  let insertText = '';
  if (type === 'image') {
    const url = prompt('Masukkan Link URL Gambar (contoh dari postimages.org atau Imgur):');
    if (url) insertText = `\n![Gambar Tugas](${url})\n`;
  } else if (type === 'link') {
    const text = prompt('Masukkan Nama Dokumen (contoh: Download PDF Tugas):');
    if (text) {
      const url = prompt('Masukkan Link Dokumen (contoh: Link Google Drive):');
      if (url) insertText = `\n[📁 ${text}](${url})\n`;
    }
  } else if (type === 'bold') {
    insertText = `**Teks Tebal**`;
  } else if (type === 'list') {
    insertText = `\n- Poin 1\n- Poin 2\n`;
  }

  if (insertText) {
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    textarea.value = text.slice(0, start) + insertText + text.slice(end);
    textarea.focus();
  }
}
</script>
