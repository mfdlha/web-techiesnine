<!-- =======================================================================
     HEADER HALAMAN KELOLA MUTASI KAS KELAS
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  <div class="max-w-7xl mx-auto">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 text-stone-700 dark:text-stone-300 mb-2 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Panel Admin • Bendahara & Keuangan</span>
        </div>
        
        <h1 class="font-heading font-extrabold text-2xl sm:text-3xl tracking-tight text-stone-900 dark:text-white">
          Buku Mutasi Kas Kelas
        </h1>
        
        <p class="text-sm text-stone-600 dark:text-stone-400 mt-1">
          Catatan lengkap penerimaan iuran mingguan dan pengeluaran operasional kas kelas 05TPLP009.
        </p>
      </div>

      <!-- Action Buttons & Quick Balance -->
      <div class="flex items-center gap-2.5 self-start sm:self-auto flex-wrap">
        <% if (typeof saldoKas !== 'undefined') { %>
          <div class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-700 text-xs font-medium text-stone-700 dark:text-stone-300 shadow-xs">
            <span>Saldo: </span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400 font-mono tabular-nums">
              Rp <%= Number(saldoKas || 0).toLocaleString('id-ID') %>
            </span>
          </div>
        <% } %>

        <a 
          href="/admin" 
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 transition"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
          </svg>
          <span>Dashboard</span>
        </a>

        <!-- Form Tarik Data Spreadsheet & Tombol Tambah Kas (Flexbox gap-3) -->
        <div class="flex items-center gap-3">
          <form action="/admin/kas/sync" method="POST" class="inline m-0">
            <button 
              type="submit" 
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 transition shadow-xs cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
              </svg>
              <span>Tarik Data Spreadsheet</span>
            </button>
          </form>

          <a 
            href="/admin/kas/add" 
            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white shadow-xs transition"
          >
            <span>+ Catat Kas</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Notification Toast Feedback -->
    <% if (typeof status !== 'undefined' && status) { %>
      <div class="mt-5 alert-toast">
        <% if (status === 'sync_success' || status === 'kas_sync_sukses') { %>
          <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
            <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Data buku kas berhasil disinkronkan langsung dari Google Spreadsheet!</span>
          </div>
        <% } else if (status === 'kas_sukses') { %>
          <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
            <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Transaksi kas berhasil dicatat dan saldo kas diperbarui!</span>
          </div>
        <% } else if (status === 'kas_edit_sukses') { %>
          <div class="flex items-center gap-2.5 p-4 rounded-xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800 text-sky-800 dark:text-sky-300 text-xs sm:text-sm font-medium">
            <svg class="w-5 h-5 flex-shrink-0 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
            <span>Perubahan data transaksi kas berhasil diperbarui!</span>
          </div>
        <% } else if (status === 'kas_hapus_sukses') { %>
          <div class="flex items-center gap-2.5 p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs sm:text-sm font-medium">
            <svg class="w-5 h-5 flex-shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
            </svg>
            <span>Data transaksi kas berhasil dihapus dari database.</span>
          </div>
        <% } else if (status === 'sync_error' || status === 'gagal') { %>
          <div class="flex items-center gap-2.5 p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-xs sm:text-sm font-medium">
            <svg class="w-5 h-5 flex-shrink-0 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
            </svg>
            <span>Gagal memproses transaksi kas. Silakan periksa kembali isian formulir.</span>
          </div>
        <% } %>
      </div>
    <% } %>

  </div>
</div>


<!-- =======================================================================
     TABEL DATA MUTASI KAS KELAS (READ, UPDATE, DELETE)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 transition-colors flex-1">
  <div class="max-w-7xl mx-auto space-y-6">

    <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200/90 dark:border-stone-800 rounded-2xl shadow-xs overflow-hidden">
      
      <!-- Table Header Bar -->
      <div class="p-5 border-b border-stone-200/80 dark:border-stone-800 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-stone-900 dark:text-white">
              Daftar Riwayat Mutasi Kas
            </h3>
            <p class="text-xs text-stone-500 dark:text-stone-400">
              Riwayat iuran masuk dan pengeluaran operasional secara kronologis
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700 tabular-nums">
            Total: <%= (typeof kas !== 'undefined' ? kas.length : 0) %> Transaksi
          </span>
          <form action="/admin/kas/sync" method="POST" class="inline m-0">
            <button 
              type="submit" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 transition cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
              </svg>
              <span>Tarik Data Spreadsheet</span>
            </button>
          </form>
          <a href="/admin/kas/add" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white transition">
            <span>+ Catat Kas</span>
          </a>
        </div>
      </div>

      <!-- Table Body with Horizontal Scroll -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="bg-stone-50 dark:bg-[#161514] border-b border-stone-200/80 dark:border-stone-800 text-[11px] font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              <th scope="col" class="py-3 pl-6 pr-4 font-semibold">#</th>
              <th scope="col" class="py-3 px-4 font-semibold">Tanggal</th>
              <th scope="col" class="py-3 px-4 font-semibold">Keterangan Transaksi</th>
              <th scope="col" class="py-3 px-4 font-semibold">Jenis Mutasi</th>
              <th scope="col" class="py-3 px-4 font-semibold">Nominal</th>
              <th scope="col" class="py-3 px-4 font-semibold text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 dark:divide-stone-800/80">
            <% if (typeof kas !== 'undefined' && kas && kas.length > 0) { %>
              <% kas.forEach((k, index) => { %>
                <tr class="hover:bg-stone-50/60 dark:hover:bg-stone-800/30 transition">
                  <td class="pl-6 pr-4 py-4 text-sm font-medium text-stone-500 tabular-nums">
                    <%= index + 1 %>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-stone-600 dark:text-stone-400 tabular-nums whitespace-nowrap">
                    <%= k.tanggal %>
                  </td>
                  <td class="py-3.5 px-4 font-medium text-stone-900 dark:text-white max-w-sm">
                    <%= k.keterangan %>
                  </td>
                  <td class="py-3.5 px-4">
                    <% const isMasuk = (k.jenis && k.jenis.trim().toLowerCase() === 'pemasukan') || (k.keterangan && k.keterangan.toLowerCase().includes('iuran')); %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-semibold <%= isMasuk ? 'bg-emerald-100 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-400' : 'bg-rose-100 dark:bg-rose-950/40 text-rose-800 dark:text-rose-400' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= isMasuk ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                      <span><%= isMasuk ? 'Pemasukan' : 'Pengeluaran' %></span>
                    </span>
                  </td>
                  <td class="py-3.5 px-4 font-semibold tabular-nums whitespace-nowrap <%= isMasuk ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                    <%= isMasuk ? '+' : '-' %>Rp <%= Number(k.nominal || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="py-3.5 px-4 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-2">
                      <!-- Tombol Edit -->
                      <a 
                        href="/admin/kas/edit/<%= k.id %>" 
                        class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition"
                      >
                        Edit
                      </a>
                      <!-- Tombol Delete -->
                      <form method="POST" action="/admin/kas/delete/<%= k.id %>" onsubmit="return confirm('Yakin hapus transaksi kas ini?')" class="inline">
                        <button 
                          type="submit" 
                          class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-rose-200 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition"
                        >
                          Hapus
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="py-12 text-center text-xs text-stone-400 italic">
                  Belum ada mutasi transaksi kas yang dicatat di basis data. Klik tombol <strong>+ Catat Kas</strong> untuk menambahkan mutasi.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>

  </div>
</div>
