<!-- =======================================================================
     ZONA ATAS: Header Admin (bg-[#F5F4EE] dark:bg-[#1A1918] border-b border-stone-200 dark:border-stone-800)
     ======================================================================= -->
<div class="bg-[#F5F4EE] dark:bg-[#1A1918] p-6 lg:p-8 border-b border-stone-200 dark:border-stone-800 transition-colors">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 text-stone-700 dark:text-stone-300 mb-3 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Akses Terautentikasi • Administrator Kelas (Ringkasan & Metrik)</span>
      </div>
      
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-stone-900 dark:text-white">
        Dashboard Admin 05TPLP009
      </h1>
      
      <p class="text-sm text-stone-600 dark:text-stone-400 mt-2 leading-relaxed">
        Pusat ringkasan dan statistik komprehensif portal akademik kelas. Pantau metrik penugasan, buku kas, status sesi Mentari, dan struktur mata kuliah secara real-time.
      </p>
    </div>

    <!-- Quick Info Badge -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <div class="px-3.5 py-2 rounded-xl bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 text-xs text-stone-600 dark:text-stone-400 flex items-center gap-2 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Database Terhubung</span>
      </div>
    </div>
  </div>

  <!-- Notification Banner (Toast Status Feedback) -->
  <% if (typeof status !== 'undefined' && status) { %>
    <div class="mt-6 alert-toast">
      <% if (status === 'tugas_sukses' || status === 'tugas_edit_sukses' || status === 'tugas_hapus_sukses') { %>
        <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Operasi basis data tugas berhasil disinkronkan!</span>
        </div>
      <% } else if (status === 'kas_sukses' || status === 'kas_edit_sukses' || status === 'kas_hapus_sukses') { %>
        <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Operasi buku kas berhasil diperbarui di basis data!</span>
        </div>
      <% } else if (status === 'mentari_sukses' || status === 'mentari_edit_sukses' || status === 'mentari_hapus_sukses') { %>
        <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Operasi sesi Mentari berhasil disinkronkan!</span>
        </div>
      <% } else if (status === 'matkul_sukses' || status === 'matkul_edit_sukses' || status === 'matkul_hapus_sukses') { %>
        <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Data mata kuliah berhasil disinkronkan!</span>
        </div>
      <% } else if (status === 'tautan_sukses' || status === 'tautan_edit_sukses' || status === 'tautan_hapus_sukses') { %>
        <div class="flex items-center gap-2.5 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Data tautan cepat berhasil disinkronkan!</span>
        </div>
      <% } else if (status === 'gagal') { %>
        <div class="flex items-center gap-2.5 p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
          </svg>
          <span>Terjadi kendala saat memproses basis data. Silakan coba kembali.</span>
        </div>
      <% } %>
    </div>
  <% } %>

</div>


<!-- =======================================================================
     BENTO GRID: RINGKASAN & STATISTIK KELAS (4 KARTU STATISTIK UTAMA)
     ======================================================================= -->
<div class="bg-white dark:bg-[#121211] p-6 lg:p-8 transition-colors flex-1">
  <div class="max-w-7xl mx-auto space-y-8">

    <!-- Section Title -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wider">
          <span>Metrik Utama</span>
          <span>•</span>
          <span>Ringkasan & Statistik Kelas</span>
        </div>
        <h2 class="font-heading font-extrabold text-2xl tracking-tight text-stone-900 dark:text-white mt-1">
          Statistik Operasional Akademik
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-1">
          Klik tombol <strong>Kelola Data</strong> untuk masuk ke tabel entitas terkait, atau gunakan <strong>+ Tambah</strong> untuk membuka formulir.
        </p>
      </div>
    </div>

    <!-- 4-Card Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- KARTU 1: TOTAL TUGAS TERCATAT -->
      <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 rounded-2xl p-6 hover:border-stone-300 dark:hover:border-stone-700 transition duration-200 flex flex-col justify-between shadow-xs group">
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300 border border-blue-200/60 dark:border-blue-900/50">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span>Tugas Kuliah</span>
            </span>
            <div class="w-9 h-9 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
          </div>

          <!-- Big Stat Number -->
          <div class="mt-2">
            <div class="text-4xl lg:text-5xl font-extrabold font-heading tabular-nums tracking-tight text-stone-900 dark:text-white">
              <%= (typeof stats !== 'undefined' && stats.totalTugas) ? stats.totalTugas : 0 %>
            </div>
            <div class="text-sm font-semibold text-stone-700 dark:text-stone-300 mt-1">
              Tugas Tercatat
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Total penugasan mandiri dan kelompok yang tersimpan dalam sistem.
            </p>
          </div>
        </div>

        <!-- Action Links -->
        <div class="mt-auto pt-4 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between gap-2 overflow-hidden">
          <a 
            href="/admin/tugas-list" 
            class="text-xs sm:text-sm font-medium text-stone-500 hover:text-stone-900 dark:hover:text-white flex items-center gap-1 transition-colors whitespace-nowrap truncate"
          >
            <span class="truncate">Kelola Tugas</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </a>
          <a 
            href="/admin/tugas/add" 
            class="px-3 py-1.5 bg-white dark:bg-stone-800 text-stone-900 dark:text-white border border-stone-200 dark:border-stone-700 rounded-lg text-xs font-semibold hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors whitespace-nowrap shrink-0"
          >
            <span>+ Tambah</span>
          </a>
        </div>
      </div>


      <!-- KARTU 2: TOTAL SALDO KAS KELAS -->
      <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 rounded-2xl p-6 hover:border-stone-300 dark:hover:border-stone-700 transition duration-200 flex flex-col justify-between shadow-xs group">
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-900/50">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Kas Kelas</span>
            </span>
            <div class="w-9 h-9 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
              </svg>
            </div>
          </div>

          <!-- Big Stat Number -->
          <div class="mt-2">
            <div class="text-3xl font-extrabold font-heading tabular-nums tracking-tight text-emerald-600 dark:text-emerald-400 break-words">
              Rp <%= (typeof stats !== 'undefined' && stats.saldoKas != null) ? Number(stats.saldoKas).toLocaleString('id-ID') : '0' %>
            </div>
            <div class="text-sm font-semibold text-stone-700 dark:text-stone-300 mt-1">
              Saldo Bersih Kas
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Akumulasi iuran pemasukan dikurangi mutasi pengeluaran kelas.
            </p>
          </div>
        </div>

        <!-- Action Links -->
        <div class="mt-auto pt-4 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between gap-2 overflow-hidden">
          <a 
            href="/admin/kas-list" 
            class="text-xs sm:text-sm font-medium text-stone-500 hover:text-stone-900 dark:hover:text-white flex items-center gap-1 transition-colors whitespace-nowrap truncate"
          >
            <span class="truncate">Buku Mutasi</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </a>
          <a 
            href="/admin/kas/add" 
            class="px-3 py-1.5 bg-white dark:bg-stone-800 text-stone-900 dark:text-white border border-stone-200 dark:border-stone-700 rounded-lg text-xs font-semibold hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors whitespace-nowrap shrink-0"
          >
            <span>+ Catat Kas</span>
          </a>
        </div>
      </div>


      <!-- KARTU 3: JADWAL MENTARI AKTIF -->
      <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 rounded-2xl p-6 hover:border-stone-300 dark:hover:border-stone-700 transition duration-200 flex flex-col justify-between shadow-xs group">
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200/60 dark:border-amber-900/50">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              <span>Mentari LMS</span>
            </span>
            <div class="w-9 h-9 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
              </svg>
            </div>
          </div>

          <!-- Big Stat Number -->
          <div class="mt-2">
            <div class="text-4xl lg:text-5xl font-extrabold font-heading tabular-nums tracking-tight text-stone-900 dark:text-white">
              <%= (typeof stats !== 'undefined' && stats.totalMentari != null) ? stats.totalMentari : 0 %>
            </div>
            <div class="text-sm font-semibold text-stone-700 dark:text-stone-300 mt-1">
              Sesi Mentari Aktif
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Jadwal sesi absensi, forum, atau kuis daring yang berstatus Buka.
            </p>
          </div>
        </div>

        <!-- Action Links -->
        <div class="mt-auto pt-4 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between gap-2 overflow-hidden">
          <a 
            href="/admin/mentari-list" 
            class="text-xs sm:text-sm font-medium text-stone-500 hover:text-stone-900 dark:hover:text-white flex items-center gap-1 transition-colors whitespace-nowrap truncate"
          >
            <span class="truncate">Kelola Mentari</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </a>
          <a 
            href="/admin/mentari/add" 
            class="px-3 py-1.5 bg-white dark:bg-stone-800 text-stone-900 dark:text-white border border-stone-200 dark:border-stone-700 rounded-lg text-xs font-semibold hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors whitespace-nowrap shrink-0"
          >
            <span>+ Tambah</span>
          </a>
        </div>
      </div>


      <!-- KARTU 4: TOTAL MATA KULIAH -->
      <div class="bg-white dark:bg-[#1C1B1A] border border-stone-200 dark:border-stone-800 rounded-2xl p-6 hover:border-stone-300 dark:hover:border-stone-700 transition duration-200 flex flex-col justify-between shadow-xs group">
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-purple-50 text-purple-700 dark:bg-purple-950/50 dark:text-purple-300 border border-purple-200/60 dark:border-purple-900/50">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
              <span>Akademik</span>
            </span>
            <div class="w-9 h-9 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
              </svg>
            </div>
          </div>

          <!-- Big Stat Number -->
          <div class="mt-2">
            <div class="text-4xl lg:text-5xl font-extrabold font-heading tabular-nums tracking-tight text-stone-900 dark:text-white">
              <%= (typeof stats !== 'undefined' && stats.totalMatkul != null) ? stats.totalMatkul : 0 %>
            </div>
            <div class="text-sm font-semibold text-stone-700 dark:text-stone-300 mt-1">
              Mata Kuliah
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Mata kuliah aktif semester ini lengkap dengan dosen & bobot SKS.
            </p>
          </div>
        </div>

        <!-- Action Links -->
        <div class="mt-auto pt-4 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between gap-2 overflow-hidden">
          <a 
            href="/admin/matkul-list" 
            class="text-xs sm:text-sm font-medium text-stone-500 hover:text-stone-900 dark:hover:text-white flex items-center gap-1 transition-colors whitespace-nowrap truncate"
          >
            <span class="truncate">Daftar Matkul</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </a>
          <a 
            href="/admin/matkul/add" 
            class="px-3 py-1.5 bg-white dark:bg-stone-800 text-stone-900 dark:text-white border border-stone-200 dark:border-stone-700 rounded-lg text-xs font-semibold hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors whitespace-nowrap shrink-0"
          >
            <span>+ Tambah</span>
          </a>
        </div>
      </div>

    </div>


    <!-- =====================================================================
         PINTASAN TAMBAHAN: TAUTAN CEPAT & SHORTCUT KELOLA SEMUA MODUL
         ===================================================================== -->
    <div class="bg-stone-50 dark:bg-[#181716] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-6 lg:p-7">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-semibold bg-white dark:bg-[#201F1E] border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-300">
            <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
            </svg>
            <span>Tautan Cepat Eksternal</span>
          </div>
          <h3 class="font-heading font-bold text-lg text-stone-900 dark:text-white mt-2">
            Pintasan Tautan Eksternal Kelas
          </h3>
          <p class="text-xs text-stone-600 dark:text-stone-400 mt-1 max-w-xl">
            Tersimpan <strong class="text-stone-900 dark:text-white font-mono tabular-nums"><%= (typeof stats !== 'undefined' && stats.totalTautan != null) ? stats.totalTautan : 0 %> tautan aktif</strong> untuk Google Drive, Portal UNPAM, dan grup koordinasi kelas.
          </p>
        </div>

        <div class="flex items-center flex-wrap gap-2.5">
